# Papercusp Phone app — LiveKit media server.
# Docs: infra/phone-app/README.md in the papercusp repo (plan phone-app-2026-08-30, P-002).
# Paths use the %h specifier so this unit is not bound to one machine's home.
[Unit]
Description=Papercusp Phone app — LiveKit media server (plan phone-app-2026-08-30 P-002)
After=network.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/livekit-server --config %h/.config/papercusp-phone/livekit-server.yaml
Restart=on-failure
RestartSec=5
# Do not let a crash-loop hammer the box; a genuinely broken config should stop
# and stay stopped so it is visible rather than silently retrying forever.

[Install]
WantedBy=default.target

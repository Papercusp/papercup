{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{revokeContributorViaGithub}from\"../../sync/hyperbee/revoke-contributor\";import{revokeHiveContributor}from\"../../hive-revoke-contributor\";var revoke_contributor_default=defineTool({name:\"substrate:revoke_contributor\",profile:\"engineer\",description:\"OWNER action: revoke another contributor by adding their device pubkeys to a revocation set. Scope is per-HARNESS (`harnessSlug`) or per-HIVE (`hiveSlug` \\u2014 revokes from the whole Hive's federation at once, P-006). Every peer honors it on the next admission re-verify and drops them from live federation. Harness scope requires a repo-admin token; Hive scope requires holding the Hive key.\",capability:\"intel:write\",guidance:{when:\"OWNER action: revoke ANOTHER contributor by adding their device pubkeys to a revocation set. Pass `harnessSlug` to drop them from ONE harness's federation (repo-admin token), or `hiveSlug` to drop them from the WHOLE Hive's federation in one action (P-006 \\u2014 requires this Swarm to hold the Hive key). Use when a contributor is a confirmed bad actor, their account is compromised, or they must be removed from the shared federation entirely.\",notWhen:\"Revoking your OWN device \\u2014 use `substrate:revoke_self_device` instead. For harness scope, not when the token lacks GitHub admin on the shared repo. For Hive scope, not when this Swarm does not hold the Hive private key (only the owning Swarm may revoke Hive-wide).\",chaining:\"Resolve the contributor's githubUserId from the Contributors tab, `dev:dogfood_substrate_status`, `harness:membership`, or `hive:get` first \\u2014 githubUserId is the stable numeric GitHub user id, not the login.\"},requirePrincipal:false,agentRoles:[\"operator\",\"debugger\",\"architect\"],args:z.object({workspaceId:z.string().min(1).describe(\"The workspace ID the harness/Hive belongs to.\"),harnessSlug:z.string().min(1).optional().describe(\"HARNESS-scoped revoke: the harness slug. Provide EITHER harnessSlug OR hiveSlug.\"),hiveSlug:z.string().min(1).optional().describe(\"HIVE-scoped revoke: the Hive's home slug \\u2014 revokes the contributor from the WHOLE Hive's federation (all its harnesses) at once (P-006). Provide EITHER harnessSlug OR hiveSlug.\"),githubUserId:z.number().int().positive().describe(\"The NUMERIC GitHub user id of the contributor to revoke (e.g. 12345). This is the stable id, not the login string. Their device pubkeys are added to the revocation set.\")}).refine(a=>!!a.harnessSlug!==!!a.hiveSlug,{message:\"Provide exactly one of harnessSlug (harness scope) or hiveSlug (Hive scope).\"}),async handler(args){const result=args.hiveSlug?await revokeHiveContributor({workspaceId:args.workspaceId,hiveHomeSlug:args.hiveSlug,githubUserId:args.githubUserId}):await revokeContributorViaGithub({workspaceId:args.workspaceId,harnessSlug:args.harnessSlug,githubUserId:args.githubUserId});return{content:[{type:\"text\",text:JSON.stringify(result)}]}}});export{revoke_contributor_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAwBA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,+BAAkC,yCAC3C,OAAS,0BAA6B,gCAEtC,IAAO,2BAAQ,WAAW,CACxB,KAAM,+BACN,QAAS,WACT,YACE,4YACF,WAAY,cACZ,SAAU,CACR,KAAM,gcACN,QACE,gRACF,SACE,sNACJ,EACA,iBAAkB,MAClB,WAAY,CAAC,WAAY,WAAY,WAAW,EAChD,KAAM,EACH,OAAO,CACN,YAAa,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,SAAS,+CAA+C,EACvF,YAAa,EACV,OAAO,EACP,IAAI,CAAC,EACL,SAAS,EACT,SAAS,kFAAkF,EAC9F,SAAU,EACP,OAAO,EACP,IAAI,CAAC,EACL,SAAS,EACT,SACC,uLACF,EACF,aAAc,EACX,OAAO,EACP,IAAI,EACJ,SAAS,EACT,SACC,0KACF,CACJ,CAAC,EACA,OAAQ,GAAM,CAAC,CAAC,EAAE,cAAgB,CAAC,CAAC,EAAE,SAAU,CAC/C,QAAS,8EACX,CAAC,EACH,MAAM,QAAQ,KAAM,CAClB,MAAM,OAAS,KAAK,SAChB,MAAM,sBAAsB,CAC1B,YAAa,KAAK,YAClB,aAAc,KAAK,SACnB,aAAc,KAAK,YACrB,CAAC,EACD,MAAM,2BAA2B,CAC/B,YAAa,KAAK,YAClB,YAAa,KAAK,YAClB,aAAc,KAAK,YACrB,CAAC,EACL,MAAO,CACL,QAAS,CAAC,CAAE,KAAM,OAAQ,KAAM,KAAK,UAAU,MAAM,CAAE,CAAC,CAC1D,CACF,CACF,CAAC","names":[],"ignoreList":[],"sources":["/h
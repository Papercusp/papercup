{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/tooldef\";const SLUG_RE=/^[a-z0-9._-]+$/i;var tag_vocabulary_default=defineTool({name:\"features:tag_vocabulary\",profile:\"engineer\",capability:\"features:read\",guidance:{when:\"You need the set of known feature tags before tagging a new one \\u2014 keeps tags consistent across the harness.\",notWhen:\"For finding features BY a tag, use `features:search` (free-text) or `features:list_related`.\"},args:z.object({slug:z.string().min(1),limit:z.number().int().positive().max(500).default(100)}),async handler(args,ctx){if(!SLUG_RE.test(args.slug)){return{data:[],degraded:true,degradedReasons:[`invalid slug ${JSON.stringify(args.slug)}`]}}let rows=[];try{rows=await ctx.tx`\n        SELECT tag, COUNT(*)::bigint AS count\n          FROM harness_shared.harness_features_consolidated,\n               jsonb_array_elements_text(COALESCE(tags, '[]'::jsonb)) AS tag\n         WHERE harness_slug = ${args.slug}\n         GROUP BY tag\n         ORDER BY count DESC, tag ASC\n         LIMIT ${args.limit}\n      `}catch(err){return{data:[],degraded:true,degradedReasons:[`features:tag_vocabulary query failed: ${err.message.slice(0,200)}`]}}const data=rows.map(r=>({tag:r.tag,count:Number(r.count)}));return{data}}});export{tag_vocabulary_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAWA,OAAS,MAAS,MAClB,OAAS,eAAkB,qBAE3B,MAAM,QAAU,kBAOhB,IAAO,uBAAQ,WAAW,CACxB,KAAM,0BACN,QAAS,WACT,WAAY,gBACZ,SAAU,CACR,KAAM,mHACN,QAAS,8FACX,EACA,KAAM,EAAE,OAAO,CACb,KAAM,EAAE,OAAO,EAAE,IAAI,CAAC,EAEtB,MAAO,EAAE,OAAO,EAAE,IAAI,EAAE,SAAS,EAAE,IAAI,GAAG,EAAE,QAAQ,GAAG,CACzD,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,GAAI,CAAC,QAAQ,KAAK,KAAK,IAAI,EAAG,CAC5B,MAAO,CAAE,KAAM,CAAC,EAAG,SAAU,KAAM,gBAAiB,CAAC,gBAAgB,KAAK,UAAU,KAAK,IAAI,CAAC,EAAE,CAAE,CACpG,CAEA,IAAI,KAA8C,CAAC,EACnD,GAAI,CAEF,KAAO,MAAM,IAAI;AAAA;AAAA;AAAA;AAAA,gCAIS,KAAK,IAAI;AAAA;AAAA;AAAA,iBAGxB,KAAK,KAAK;AAAA,OAEvB,OAAS,IAAK,CACZ,MAAO,CACL,KAAM,CAAC,EACP,SAAU,KACV,gBA
{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{resolveAgentIdentity}from\"../coordination/identity\";import{COORD_ROLES}from\"../coordination/roles\";import{checkScorecardFreshness}from\"../../scorecard-freshness\";var freshness_default=defineTool({name:\"scorecards:freshness\",profile:\"engineer\",description:'Has the Overwatch emitted a COMPLETE scorecard for a rubric since a given time (its last wake)? The emission-freshness check (monitor-the-monitor): returns status = fresh (a COMPLETE scorecard landed in-window) | partial-only (scorecards landed but ALL incomplete \\u2014 a silent truncation) | stale (NOTHING landed \\u2014 a silent emission gap), plus emitted / complete / count / partialCount, lastEmittedAt, lastCompleteAt, and latestMissingKeys (what is unrated right now). Reads scorecards:list (P-013); a \"complete\" scorecard rates every rubric criterion.',guidance:{when:\"You want to know whether the Overwatch is actually emitting COMPLETE scorecards, not just whether it emitted anything \\u2014 monitor-the-monitor. Did a complete hive-coordination-health scorecard land since the last wake (status fresh), or is it silently skipping (stale) / truncating to partials (partial-only)? Pass `since` = the last wake for a precise check.\",notWhen:`You want the scorecard ROWS + their ratings \\u2014 scorecards:list. You want a criterion's rating TREND over time \\u2014 rubrics:trend. You are FILING a scorecard \\u2014 improvements:capture { lane: \"observation\", observation: { rubricRef, ratings } }.`,chaining:'scorecards:freshness { rubricRef: \"hive-coordination-health\", since } \\u2192 status stale/partial-only \\u21D2 the Overwatch missed or truncated \\u2192 scorecards:list { rubricRef, since } to see what (if anything) it emitted, or check latestMissingKeys for which criteria were dropped.'},capability:\"coord:read\",requirePrincipal:false,agentRoles:[...COORD_ROLES],args:z.object({rubricRef:z.string().describe('the rubric to check freshness for, e.g. \"hive-coordination-health\"'),sourceHive:z.string().optional().describe(\"restrict to scorecards from one source-hive\"),since:z.string().optional().describe(`ISO timestamp \\u2014 the window start; pass the Overwatch's last wake for a precise \"since last wake\" check. Omit for a lookback default.`),lookbackMs:z.number().int().positive().optional().describe(\"fallback window size in ms when `since` is omitted (default 2h)\")}),async handler(args,ctx){resolveAgentIdentity(ctx);const freshness=await checkScorecardFreshness({rubricRef:args.rubricRef,sourceHive:args.sourceHive,since:args.since,lookbackMs:args.lookbackMs});return{content:[{type:\"text\",text:JSON.stringify({ok:true,freshness})}]}}});export{freshness_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAUA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,yBAA4B,2BACrC,OAAS,gBAAmB,wBAC5B,OAAS,4BAA+B,4BAExC,IAAO,kBAAQ,WAAW,CACxB,KAAM,uBACN,QAAS,WACT,YACE,mjBACF,SAAU,CACR,KAAM,6WACN,QACE,+PACF,SACE,+RACJ,EACA,WAAY,aACZ,iBAAkB,MAClB,WAAY,CAAC,GAAG,WAAW,EAC3B,KAAM,EAAE,OAAO,CACb,UAAW,EAAE,OAAO,EAAE,SAAS,oEAAoE,EACnG,WAAY,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,6CAA6C,EACxF,MAAO,EACJ,OAAO,EACP,SAAS,EACT,SACC,2IACF,EACF,WAAY,EACT,OAAO,EACP,IAAI,EACJ,SAAS,EACT,SAAS,EACT,SAAS,iEAAiE,CAC/E,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,qBAAqB,GAAG,EACxB,MAAM,UAAY,MAAM,wBAAwB,CAC9C,UAAW,KAAK,UAChB,WAAY,KAAK,WACjB,MAAO,KAAK,MACZ,WAAY,KAAK,UACnB,CAAC,EACD,MAAO,CACL,QAAS,CAAC,CAAE,KAAM,OAAiB,KAAM,KAAK,UAAU,CAAE,GAAI,KAAM,SAAU,CAAC,CAAE,CAAC,CACpF,CACF,CACF,CAAC","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercup/packages/operator-core/lib/agent-tools/scorecards/freshness.ts"],"sourcesContent":[null]}}
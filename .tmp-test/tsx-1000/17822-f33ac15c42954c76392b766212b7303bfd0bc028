{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{COORD_ROLES}from\"../roles\";import{readCoordFeed,ALL_COORD_KINDS,MAX_FEED_LIMIT}from\"../feed\";import{boundRowField}from\"../../_bound-output\";const AGENT_FEED_DEFAULT=30;const FEED_BODY_CAP=200;const FEED_BODY_BUDGET=8e3;const FEED_SUMMARY_CAP=400;const FEED_SUMMARY_BUDGET=1e4;var feed_default=defineTool({name:\"coord:feed\",description:\"Read the COMPLETE coordination stream across every agent and channel \\u2014 messages, acks, notifies, broadcasts, handoffs, escalations, resolutions, plan events \\u2014 newest-first with a next-page cursor. Filter by kinds, owner (matches sender OR recipient; broadcasts match any owner), plan_slug, free-text `q` (over summary/body/from/to), and a since_ts/before_ts time window. before_ts is the pagination cursor (pass back the returned `nextCursor`). Returns `{ count, total, by_kind, next_cursor, rows }`; each row is the raw envelope plus `surface` (messages|escalations|handoffs|plan-events) and a derived `broadcast` flag.\",guidance:{when:\"You need the full fleet-wide coordination timeline \\u2014 auditing what agents said to each other, tracing a broadcast/handoff/escalation chain, or backing an observer UI. The all-traffic counterpart to the per-owner coord:inbox.\",notWhen:'For YOUR addressed messages use coord:inbox; for open human escalations use coord:escalations; for live \"who is active\" use coord:presence. coord:feed is the read-everything firehose, not a working inbox.'},capability:\"audit:read\",requirePrincipal:false,agentRoles:[...COORD_ROLES],args:z.object({kinds:z.array(z.enum(ALL_COORD_KINDS)).optional().describe(\"Restrict to these envelope kinds. Omitted = every kind.\"),owner:z.string().optional().describe(\"An ownerId. Matches envelopes where this owner is the sender OR a recipient; broadcasts match any owner.\"),plan_slug:z.string().optional().describe(\"Restrict to one plan slug.\"),q:z.string().optional().describe(\"Case-insensitive substring over summary/body/from/to/plan_slug.\"),since_ts:z.string().optional().describe(\"Strictly later than this ISO timestamp (older bound).\"),before_ts:z.string().optional().describe(\"Strictly earlier than this ISO timestamp (newer bound) \\u2014 the pagination cursor; pass back the returned next_cursor.\"),limit:z.number().int().min(1).max(MAX_FEED_LIMIT).optional().describe(`Max rows (newest kept). Agent default ${AGENT_FEED_DEFAULT} (kept small because each row is a full envelope), max ${MAX_FEED_LIMIT}. Per-row body/summary are excerpted (body_truncated/_full_chars); paginate with before_ts/next_cursor for more.`)}),async handler(args){const{rows,nextCursor,total,byKind}=await readCoordFeed({kinds:args.kinds,owner:args.owner,plan_slug:args.plan_slug,q:args.q,since_ts:args.since_ts,before_ts:args.before_ts,limit:args.limit??AGENT_FEED_DEFAULT});let boundedRows=boundRowField(rows,\"body\",FEED_BODY_CAP,FEED_BODY_BUDGET);boundedRows=boundRowField(boundedRows,\"summary\",FEED_SUMMARY_CAP,FEED_SUMMARY_BUDGET);return{content:[{type:\"text\",text:JSON.stringify({count:boundedRows.length,total,by_kind:byKind,next_cursor:nextCursor,rows:boundedRows})}]}}});export{feed_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAgBA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,gBAAmB,WAC5B,OACE,cACA,gBACA,mBACK,UACP,OAAS,kBAAqB,sBAQ9B,MAAM,mBAAqB,GAC3B,MAAM,cAAgB,IACtB,MAAM,iBAAmB,IACzB,MAAM,iBAAmB,IACzB,MAAM,oBAAsB,IAE5B,IAAO,aAAQ,WAAW,CACxB,KAAM,aACN,YACE,ynBACF,SAAU,CACR,KACE,wOACF,QACE,8MACJ,EAIA,WAAY,aACZ,iBAAkB,MAClB,WAAY,CAAC,GAAG,WAAW,EAC3B,KAAM,EAAE,OAAO,CACb,MAAO,EACJ,MAAM,EAAE,KAAK,eAAe,CAAC,EAC7B,SAAS,EACT,SAAS,yDAAyD,EACrE,MAAO,EACJ,OAAO,EACP,SAAS,EACT,SAAS,0GAA0G,EACtH,UAAW,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,4BAA4B,EACtE,EAAG,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,iEAAiE,EACnG,SAAU,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,uDAAuD,EAChG,UAAW,EACR,OAAO,EACP,SAAS,EACT,SAAS,0HAAqH,EACjI,MAAO,EACJ,OAAO,EACP,IAAI,EACJ,IAAI,CAAC,EACL,IAAI,cAAc,EAClB,SAAS,EACT,SAA
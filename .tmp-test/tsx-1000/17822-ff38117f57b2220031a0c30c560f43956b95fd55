{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import{getOrgPg,upsertRoutine}from\"@papercusp/db-org\";import{activeWorkspaceId}from\"../../workspace-registry\";import{computeNextFireAt}from\"./cron\";const LOOP_WAKE_ACTION=\"system:loop-wake\";const LOOP_INTERVAL_FLOOR_SEC=60;function loopRoutineName(ownerId){return`loop-${ownerId}`}__name(loopRoutineName,\"loopRoutineName\");const DEFAULT_LOOP_WAKE_PROMPT_TEMPLATE=[\"\\u{1F501} Loop wake (every ~{intervalSec}s after each turn settles). You are continuing your OWN warm session toward: {goal}\",\"\",\"Each wake:\",\"1. Decide the next concrete unit(s) of work. If the goal is DONE or there's nothing left to do, call `loop:end` and stop \\u2014 do not spin on empty wakes.\",\"2. Create + SELF-ASSIGN each unit as a work_item in ONE atomic call:\",\"     work_items:create { kind:'task', title:'\\u2026', harness:'{harness}', assign_to:'{ownerId}' }\",\"   (creates AND claims it for you in one write \\u2014 your work then shows in fleet:assignments, owned, with no create\\u2192claim race). Omit `topics` \\u2014 a self-owned loop item needs no topic fanout.\",\"3. Do the work; update `work_items:set_state` (in_progress \\u2192 completed) and your plan as you go.\",\"4. When this iteration's work is done (or you are blocked), END YOUR TURN. The loop re-wakes this same session ~{intervalSec}s after the turn settles.\",\"\",\"To stop: `loop:end`. If you are blocked on something external (a build, another agent, an owner decision), call `loop:end` and say why rather than burning wakes spinning. `loop:status` shows the loop state.\"].join(\"\\n\");function buildLoopWakePrompt(opts){return DEFAULT_LOOP_WAKE_PROMPT_TEMPLATE.replace(/\\{intervalSec\\}/g,String(opts.intervalSec)).replace(/\\{harness\\}/g,opts.harness).replace(/\\{ownerId\\}/g,opts.ownerId).replace(/\\{goal\\}/g,opts.goal)}__name(buildLoopWakePrompt,\"buildLoopWakePrompt\");async function 
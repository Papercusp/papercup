{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/tooldef\";import{getOrgPg}from\"@papercusp/db-org\";var list_workspaces_default=defineTool({name:\"papercusp:list_workspaces\",profile:\"engineer\",requirePrincipal:false,crossWorkspace:true,guidance:{when:\"Discovery helper for superuser shells \\u2014 list all workspaces in the installation. Used when scope-switching.\",notWhen:\"For the CURRENT workspace details, use the operator-state APIs. papercusp:list_workspaces is the cross-workspace enumerator.\"},capability:\"workspaces:read\",args:z.object({}).strict(),async handler(){const{sql}=getOrgPg();const rows=await sql`\n      SELECT r.workspace_id,\n             p->>'slug'   AS harness_slug,\n             r.updated_at AS last_active_ts\n      FROM harness_shared.harness_registry r\n      LEFT JOIN LATERAL jsonb_array_elements(COALESCE(r.payload->'projects', '[]'::jsonb)) AS p ON true\n      ORDER BY r.workspace_id, harness_slug\n    `;const buckets=new Map;for(const r of rows){const b=buckets.get(r.workspace_id)??{harnesses:[],lastActiveTs:0};if(r.harness_slug)b.harnesses.push(r.harness_slug);const ts=Number(r.last_active_ts??0);if(ts>b.lastActiveTs)b.lastActiveTs=ts;buckets.set(r.workspace_id,b)}const workspaces=Array.from(buckets.entries()).map(([slug,b])=>({slug,harnesses:b.harnesses,lastActiveTs:b.lastActiveTs})).sort((a,b)=>b.lastActiveTs-a.lastActiveTs);return{data:{workspaces,defaultWorkspace:workspaces.find(w=>w.slug===\"default\")?.slug??workspaces[0]?.slug??null}}}});export{list_workspaces_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAYA,OAAS,MAAS,MAClB,OAAS,eAAkB,qBAC3B,OAAS,aAAgB,oBAEzB,IAAO,wBAAQ,WAAW,CACxB,KAAM,4BACN,QAAS,WAIT,iBAAkB,MAIlB,eAAgB,KAChB,SAAU,CACR,KAAM,mHACN,QAAS,8HACX,EACA,WAAY,kBACZ,KAAM,EAAE,OAAO,CAAC,CAAC,EAAE,OAAO,EAC1B,MAAM,SAAU,CAMd,KAAM,CAAE,GAAI,EAAI,SAAS,EASzB,MAAM,KAAO,MAAM;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA;AAAA,MAQnB,MAAM,QAAU,IAAI,IACpB,UAAW,KAAK,KAAM,CACpB,MAAM,EAAI,QAAQ,IAAI,EAAE,YAAY,
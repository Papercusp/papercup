{"code":"import{z}from\"zod\";import{defineTool,SU_ROLES}from\"@papercusp/agent-mcp\";import{createChat}from\"../../agent-chats-data\";var create_default=defineTool({name:\"agent_chats:create\",description:\"Open a new chat session for a role in a harness; optionally bind it to a feature_id.\",capability:\"agent_chats:write\",guidance:{when:`User says \"ask the architect to ...\", \"have the worker do ...\", or you're routing a request to a role-scoped agent. Step 1 of the two-step dispatch flow.`,notWhen:\"For replying in the user's direct chat, just speak \\u2014 don't spin up a new agent chat. For talking to ANOTHER user, use `messages:send`. For spawning a one-shot agent process (not a long-running chat), use `<spawn>` / `orchestrator.spawn`.\",chaining:\"Pair with `agent_chats:send_message` immediately (step 2 of the dispatch flow), then `ui:dispatch` with `/harness/<slug>?chat=<chatId>` so the user can watch the conversation.\"},requirePrincipal:false,agentRoles:[...SU_ROLES],rolesQuota:{worker:{perChunk:5},operator:{perRun:50}},args:z.object({slug:z.string().min(1),role:z.string().min(1),feature_id:z.string().optional(),title:z.string().optional()}),async handler(args){const result=await createChat(args);if(!result.ok){return{content:[{type:\"text\",text:JSON.stringify({error:result.error})}]}}return{content:[{type:\"text\",text:JSON.stringify(result.data)}]}}});export{create_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AASA,OAAS,MAAS,MAClB,OAAS,WAAY,aAAgB,uBACrC,OAAS,eAAkB,yBAE3B,IAAO,eAAQ,WAAW,CACxB,KAAM,qBACN,YACE,uFACF,WAAY,oBACZ,SAAU,CACR,KAAM,4JACN,QAAS,qPACT,SAAU,iLACZ,EACA,iBAAkB,MAClB,WAAY,CAAC,GAAG,QAAQ,EACxB,WAAY,CAAE,OAAQ,CAAE,SAAU,CAAE,EAAG,SAAU,CAAE,OAAQ,EAAG,CAAE,EAChE,KAAM,EAAE,OAAO,CACb,KAAM,EAAE,OAAO,EAAE,IAAI,CAAC,EACtB,KAAM,EAAE,OAAO,EAAE,IAAI,CAAC,EACtB,WAAY,EAAE,OAAO,EAAE,SAAS,EAChC,MAAO,EAAE,OAAO,EAAE,SAAS,CAC7B,CAAC,EACD,MAAM,QAAQ,KAAM,CAClB,MAAM,OAAS,MAAM,WAAW,IAAI,EACpC,GAAI,CAAC,OAAO,GAAI,CACd,MAAO,CAAE,QAAS,
{"code":"import{BRIEF_ADMIN}from\"@papercusp/testing-shell/llm\";import{SU_RUBRIC}from\"../../rubrics/su\";import{assertTextRequires,assertTextForbids,assertToolCallCountAtLeast}from\"./_asserts\";import{makeDeltaSnapshotOverride}from\"./_overrides\";const SU_S24_DELTA_FALLBACK_COMPACTED={id:\"su-S24-delta-fallback-compacted\",version:1,target:\"su\",transport:\"in-process\",description:\"A developer asks the engineer to list the current open work items \\u2014 the assistant calls work_items:list, gets a full snapshot, and lists the 5 items. Between that turn and the next, the conversation is compacted: the verbatim list the assistant retrieved is summarized away and no longer in context. The developer then asks for the current full list \\u2014 work_items:list returns a DELTA (changes since the earlier snapshot) whose note says to re-fetch full if the base is no longer held. Because the base was compacted out, the assistant must re-fetch the full list rather than guess from the delta alone.\",persona:BRIEF_ADMIN,goal:{kind:\"user_satisfied\",declaredBy:\"sim_user\"},caps:{maxTurns:4,maxWallSecs:200,maxCostUsd:2.5},runMatrix:{repeat:3,variancePolicy:\"flag-if-stddev>0.5\"},compactionPolicy:{beforeTurn:1,upTo:2},get toolOverride(){return makeDeltaSnapshotOverride()},asserts:[assertTextRequires(/EROFS/i,{name:\"fallback-surfaces-added\",claim:\"Expected the current list to include the added row (EROFS) \\u2014 present in the re-fetched full list.\",suggestion:\"Re-fetch full when the base is gone; the fresh snapshot carries the added row.\"}),assertTextRequires(/circuit-breaker/i,{name:\"fallback-surfaces-updated\",claim:\"Expected WI-7004's current title ('circuit-breaker') \\u2014 present in the re-fetched full list.\",suggestion:\"A re-fetched full list already reflects the update; do not reconstruct it from a delta against a missing base.\"}),assertTextRequires(/NUL bytes/i,{name:\"fallback-surfaces-kept\",claim:'Expected the kept row WI-7003 (\"NUL bytes\") \\u2014 it was compacted out of context, so only a full RE-FETCH can surface it. Its absence means the model merged a delta against a base it no longer held.',suggestion:\"When the base snapshot is no longer in context, re-call work_items:list for mode:full instead of guessing.\"}),assertTextRequires(/CSV backend/i,{name:\"fallback-surfaces-kept-2\",claim:'Expected the kept row WI-7001 (\"CSV backend\") \\u2014 only the re-fetched full list carries it after compaction.',suggestion:\"Re-fetch full; do not drop base rows the model can no longer see.\"}),assertTextForbids(/debounce/i,{name:\"fallback-no-removed\",claim:\"The reply named the REMOVED row (debounce) \\u2014 the re-fetched full list does not contain it.\",suggestion:\"Report the re-fetched full list, which already omits removed rows.\"}),assertTextForbids(/naive-retry/i,{name:\"fallback-no-stale-value\",claim:\"The reply showed WI-7004's STALE pre-update title ('naive-retry') \\u2014 a re-fetched full list shows only the current title.\",suggestion:\"Use the re-fetched current value, not a remembered/stale one.\"}),assertToolCallCountAtLeast([\"work_items:list\"],3,{name:\"fallback-re-fetched-full\",claim:\"work_items:list was called fewer than 3 times \\u2014 the model did NOT fall back to a full re-fetch after the base was compacted (turn-0 full + turn-1 delta + the fallback re-fetch = 3).\",suggestion:\"On a delta whose base is no longer in context, re-call work_items:list for a fresh mode:full list.\"})],rubric:SU_RUBRIC};var S24_delta_fallback_compacted_default=SU_S24_DELTA_FALLBACK_COMPACTED;export{SU_S24_DELTA_FALLBACK_COMPACTED,S24_delta_fallback_compacted_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AA0BA,OAAS,gBAAmB,+BAG5B,OAAS,cAAiB,mBAC1B,OAAS,mBAAoB,kBAAmB,+BAAkC,aAClF,OAAS,8BAAiC,eAEnC,MAAM,gCAA4C,CACvD,GAAI,kCACJ,QAAS,EACT,OAAQ,KACR,UAAW,aACX,YACE,umBACF,QAAS,YACT,KAAM,CAAE,KAAM,iBAAkB,WAAY,UAAW,EACvD,KAAM,CAAE,SAAU,EAAG,YAAa,IAAK,WAAY,GAAI,EACvD,UAAW,CAAE,OAAQ,EAAG,eAAgB,
{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{resolveAgentIdentity}from\"../identity\";import{COORD_ROLES}from\"../roles\";import{readWatermark}from\"../watermarks\";var watermark_default=defineTool({name:\"coord:watermark\",description:\"Read a coordination watermark \\u2014 last-read ISO timestamps for messages / escalations / plan-events + the notify msg_ids surfaced. DEFAULT: your own. Pass `agent` to read a PEER's: their `read_through_ts` (messages_shown_ts) is a READ-RECEIPT \\u2014 \\u2265 your message's ts \\u21D2 they've SEEN it (ping them, don't re-route); behind \\u21D2 not yet seen (wait, or wake if idle). With `agent`+`sent_ts` you get a direct `seen` boolean.\",guidance:{when:\"Turn start \\u2014 the OMP coordination extension calls this to scope the inbox to new entries. To check if a PEER has seen a message you sent (READ-RECEIPT, EI-2042): coord:watermark { agent: <their ownerId from coord:presence>, sent_ts: <your message ts> } \\u2192 seen:true means it was injected into their context.\",notWhen:\"Routine reads \\u2014 coord:inbox without a watermark returns the full inbox.\"},capability:\"coord:read\",requirePrincipal:false,agentRoles:[...COORD_ROLES],args:z.object({agent:z.string().optional().describe(\"Read a PEER's watermark instead of your own (their full ownerId, e.g. from coord:presence). Their `read_through_ts` (messages_shown_ts) is the READ-RECEIPT: \\u2265 your message's ts \\u21D2 they've SEEN it.\"),sent_ts:z.string().optional().describe(\"With `agent`: the ISO ts of the message you sent. The tool returns `seen: <peer read_through_ts \\u2265 sent_ts>` so you needn't compare timestamps by hand.\")}),async handler(args,ctx){const identity=resolveAgentIdentity(ctx);const targetOwner=args.agent&&args.agent.trim()?args.agent.trim():identity.ownerId;const wm=await readWatermark(targetOwner);const out={owner_id:targetOwner,self:targetOwner===identity.ownerId,watermark:wm,read_through_ts:wm.messages_shown_ts};if(args.sent_ts){out.seen=!!wm.messages_shown_ts&&wm.messages_shown_ts>=args.sent_ts}return{content:[{type:\"text\",text:JSON.stringify(out)}]}}});export{watermark_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAQA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,yBAA4B,cACrC,OAAS,gBAAmB,WAC5B,OAAS,kBAAqB,gBAE9B,IAAO,kBAAQ,WAAW,CACxB,KAAM,kBACN,YACE,wbACF,SAAU,CACR,KAAM,+TACN,QAAS,8EACX,EACA,WAAY,aACZ,iBAAkB,MAClB,WAAY,CAAC,GAAG,WAAW,EAC3B,KAAM,EAAE,OAAO,CACb,MAAO,EACJ,OAAO,EACP,SAAS,EACT,SACC,+MACF,EACF,QAAS,EACN,OAAO,EACP,SAAS,EACT,SACC,6JACF,CACJ,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,MAAM,SAAW,qBAAqB,GAAG,EAEzC,MAAM,YAAc,KAAK,OAAS,KAAK,MAAM,KAAK,EAAI,KAAK,MAAM,KAAK,EAAI,SAAS,QACnF,MAAM,GAAK,MAAM,cAAc,WAAW,EAC1C,MAAM,IAA+B,CACnC,SAAU,YACV,KAAM,cAAgB,SAAS,QAC/B,UAAW,GAEX,gBAAiB,GAAG,iBACtB,EAEA,GAAI,KAAK,QAAS,CAChB,IAAI,KAAO,CAAC,CAAC,GAAG,mBAAqB,GAAG,mBAAqB,KAAK,OACpE,CACA,MAAO,CACL,QAAS,CAAC,CAAE,KAAM,OAAiB,KAAM,KAAK,UAAU,GAAG,CAAE,CAAC,CAChE,CACF,CACF,CAAC","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercup/packages/operator-core/lib/agent-tools/coordination/tools/watermark.ts"],"sourcesContent":[null]}}
{"code":"import{BRIEF_ADMIN}from\"@papercusp/testing-shell/llm\";import{SU_RUBRIC}from\"../../rubrics/su\";import{assertToolCalled,assertToolCallCountAtMost}from\"./_asserts\";import{BULK_GET_CONTEXT}from\"./_overrides\";const SU_S21_BULK_READ_NOT_HAND_LOOP={id:\"su-S21-bulk-read-not-hand-loop\",version:1,target:\"su\",transport:\"in-process\",description:\"A developer asks the engineer who owns each of the open work-items in the papercusp harness and what each one's parent is. work_items:list returns 6 open items but WITHOUT the assignee/parent detail, so the engineer must work_items:get over all 6. It should collapse those reads into ONE bulk work_items:get { ids:[\\u2026] } call (every repeated-call read is dual-arity, n=1 \\u2261 bulk-of-one) rather than issuing work_items:get { id } once per item.\",persona:BRIEF_ADMIN,goal:{kind:\"user_satisfied\",declaredBy:\"sim_user\"},caps:{maxTurns:6,maxWallSecs:200,maxCostUsd:1.5},runMatrix:{repeat:3,variancePolicy:\"flag-if-disagreement\"},toolOverride:BULK_GET_CONTEXT,asserts:[assertToolCalled([\"work_items:get\"],{name:\"reaches-for-bulk-get\",claim:\"Expected the engineer to fetch the 6 items' detail via work_items:get { ids:[\\u2026] } \\u2014 work_items:get was never called.\",suggestion:\"Pass every id you need in ONE work_items:get { ids:[\\u2026] } call.\"}),assertToolCallCountAtMost([\"work_items:get\"],1,{name:\"does-not-hand-loop-reads\",claim:\"The engineer fired per-id work_items:get reads one at a time instead of one bulk { ids:[\\u2026] } call \\u2014 n=1 repeated is exactly what the dual-arity bulk arg replaces.\",suggestion:\"Collapse the per-id reads into a single work_items:get { ids:[\\u2026] } call.\"})],rubric:SU_RUBRIC};var S21_bulk_read_not_hand_loop_default=SU_S21_BULK_READ_NOT_HAND_LOOP;export{SU_S21_BULK_READ_NOT_HAND_LOOP,S21_bulk_read_not_hand_loop_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAoBA,OAAS,gBAAmB,+BAG5B,OAAS,cAAiB,mBAC1B,OAAS,iBAAkB,8BAAiC,aAC5D,OAAS,qBA
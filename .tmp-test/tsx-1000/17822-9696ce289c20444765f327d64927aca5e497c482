{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{resolveAgentIdentity}from\"../identity\";import{COORD_ROLES}from\"../roles\";import{armInboxWake}from\"../../../events/await/inbox-wake-arm\";var await_inbox_default=defineTool({name:\"coord:await-inbox\",description:'Annotate your idle state at end-of-turn: refresh the \"why I am idle\" note on your inbox-wake watch (and optionally its wake floor), then end your turn. You are ALREADY always-armed at session start (turn-lifecycle-control), so a later coord:send {wake:true} re-invokes you whether or not you call this \\u2014 this just records why you are idle for the wake turn. Returns the watch id + your inbox-wake key.',guidance:{when:\"Optional, at end-of-turn when idle \\u2014 to record WHY you are idle (the note rides your wake turn) and tune your wake floor. You are wakeable regardless; arming is automatic at session start. Then END YOUR TURN.\",notWhen:\"You still have queued work \\u2014 keep going. A specific one-shot readiness (a lock grant, a peer's artifact) \\u2014 use events:await on that exact key. A sub-minute wait inside one turn \\u2014 just block.\",chaining:\"coord:await-inbox \\u2192 end your turn. On wake the turn text carries the message that woke you (read coord:inbox for the full set). To stop watching: events:cancel.\"},capability:\"coord:write\",requirePrincipal:false,agentRoles:[...COORD_ROLES],args:z.object({note:z.string().max(300).optional().describe(\"Why you are idle / what you are waiting for \\u2014 echoed into the wake turn.\"),min_sleep_sec:z.number().int().nonnegative().max(7*24*60*60).optional().describe(\"Per-subscriber wake floor: never re-wake within this window; a burst of sends inside it coalesces into ONE wake. Default: a sane standing floor.\"),plan_run_id:z.number().int().positive().optional().describe(\"If you are a plan run, the wake resumes the run via plans:resume instead of a session resume.\")}),async handler(args,ctx){const identity=resolveAgentIdentity(ctx);const{awaitId,eventKey,handleNote}=await armInboxWake({ownerId:identity.ownerId,note:args.note??\"idle \\u2014 awaiting work/direction (deliver-and-wake)\",minSleepSec:args.min_sleep_sec,planRunId:args.plan_run_id,workspaceId:identity.workspaceId??void 0});return{content:[{type:\"text\",text:JSON.stringify({ok:true,watch:{id:awaitId,pattern:eventKey,wake:true,once:false,min_sleep_sec:args.min_sleep_sec??null},inbox_wake_key:eventKey,wake_handle:handleNote,advice:\"Inbox-wake watch refreshed. You are always-armed at session start, so this just annotates WHY you are idle \\u2014 END YOUR TURN now; you are re-invoked when someone coord:sends you with {wake:true} (bursts coalesce). Do not poll.\"})}]}}});export{await_inbox_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAkBA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,yBAA4B,cACrC,OAAS,gBAAmB,WAC5B,OAAS,iBAAoB,uCAE7B,IAAO,oBAAQ,WAAW,CACxB,KAAM,oBACN,YACE,yZACF,SAAU,CACR,KAAM,wNACN,QACE,gNACF,SACE,uKACJ,EACA,WAAY,cACZ,iBAAkB,MAClB,WAAY,CAAC,GAAG,WAAW,EAC3B,KAAM,EAAE,OAAO,CACb,KAAM,EACH,OAAO,EACP,IAAI,GAAG,EACP,SAAS,EACT,SAAS,+EAA0E,EACtF,cAAe,EACZ,OAAO,EACP,IAAI,EACJ,YAAY,EACZ,IAAI,EAAI,GAAK,GAAK,EAAE,EACpB,SAAS,EACT,SACC,kJACF,EACF,YAAa,EACV,OAAO,EACP,IAAI,EACJ,SAAS,EACT,SAAS,EACT,SAAS,+FAA+F,CAC7G,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,MAAM,SAAW,qBAAqB,GAAG,EAIzC,KAAM,CAAE,QAAS,SAAU,UAAW,EAAI,MAAM,aAAa,CAC3D,QAAS,SAAS,QAClB,KAAM,KAAK,MAAQ,yDACnB,YAAa,KAAK,cAClB,UAAW,KAAK,YAChB,YAAa,SAAS,aAAe,MACvC,CAAC,EAED,MAAO,CACL,QAAS,CACP,CACE,KAAM,OACN,KAAM,KAAK,UAAU,CACnB,GAAI,KACJ,MAAO,CACL,GAAI,QACJ,QAAS,SACT,KAAM,KACN,KAAM,MACN,cAAe,KAAK,eAAiB,IACvC,EACA,eAAgB,SAChB,YAAa,WACb,OACE,uOACJ,CAAC,CACH,CACF,CACF,CACF,CACF,CAAC","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercup/packages/operator-core/lib/agent-tools/coordination/tools/await-inbox.ts"],"sourcesContent":[null]}}
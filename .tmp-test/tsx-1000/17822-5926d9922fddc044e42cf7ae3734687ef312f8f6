{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{resolveAgentIdentity}from\"../coordination/identity\";import{COORD_ROLES}from\"../coordination/roles\";import{listScorecards}from\"../../scorecards\";var list_default=defineTool({name:\"scorecards:list\",profile:\"engineer\",description:\"Read structured rubric SCORECARDS back \\u2014 rubric-graded observations (a rubricRef + per-criterion {rating, evidence}) that the Overwatch emits every turn and Scout consumes. Filter by rubricRef + sourceHive + a since time-window; newest-first. Each row carries {issueId, createdAt, createdBy, sourceHive, rubricRef, ratings, nKeys, missingKeys, rubricResolved} \\u2014 nKeys + missingKeys expose completeness (a partial scorecard rated < all the rubric criteria). The read side of monitoring-the-monitor (was write-only before).\",guidance:{when:\"You want to SEE the rubric scorecards that have been emitted \\u2014 e.g. did the Overwatch emit a COMPLETE hive-coordination-health scorecard recently (missingKeys empty)? what is one criterion's rating over time? is there an emission gap? The data substrate for trend/freshness/self-comparison monitoring.\",notWhen:'You want the RUBRIC definition (criteria/model/method) \\u2014 rubrics:get / rubrics:list. You want the cross-corpus meta-pattern rollup incl. rubric ratings grouped for ideation \\u2014 curation:state-of-hive. You are FILING a scorecard \\u2014 improvements:capture { lane: \"observation\", observation: { rubricRef, ratings } }.',chaining:'scorecards:list { rubricRef: \"hive-coordination-health\", since } \\u2192 inspect missingKeys for completeness / ratings for the latest standing \\u2192 drill into a row via work_items:get { id: issueId }, or rubrics:get { rubricId: rubricRef } for the criterion definitions.'},capability:\"coord:read\",requirePrincipal:false,agentRoles:[...COORD_ROLES],args:z.object({rubricRef:z.string().optional().describe('restrict to one rubric, e.g. \"hive-coordination-health\"; omit for all rubric-graded scorecards'),sourceHive:z.string().optional().describe(\"restrict to scorecards from one source-hive\"),since:z.string().optional().describe(\"ISO timestamp \\u2014 only scorecards filed at/after this (the time-window); omit for all\"),limit:z.number().int().positive().max(500).optional().describe(\"max rows, newest-first (default 100, max 500)\")}),async handler(args,ctx){resolveAgentIdentity(ctx);const scorecards=await listScorecards({rubricRef:args.rubricRef,sourceHive:args.sourceHive,since:args.since,limit:args.limit});return{content:[{type:\"text\",text:JSON.stringify({ok:true,count:scorecards.length,scorecards})}]}}});export{list_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAYA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,yBAA4B,2BACrC,OAAS,gBAAmB,wBAC5B,OAAS,mBAAsB,mBAE/B,IAAO,aAAQ,WAAW,CACxB,KAAM,kBACN,QAAS,WACT,YACE,shBACF,SAAU,CACR,KAAM,qTACN,QACE,wUACF,SACE,kRACJ,EACA,WAAY,aACZ,iBAAkB,MAClB,WAAY,CAAC,GAAG,WAAW,EAC3B,KAAM,EAAE,OAAO,CACb,UAAW,EACR,OAAO,EACP,SAAS,EACT,SAAS,gGAAgG,EAC5G,WAAY,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,6CAA6C,EACxF,MAAO,EACJ,OAAO,EACP,SAAS,EACT,SAAS,0FAAqF,EACjG,MAAO,EAAE,OAAO,EAAE,IAAI,EAAE,SAAS,EAAE,IAAI,GAAG,EAAE,SAAS,EAAE,SAAS,+CAA+C,CACjH,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,qBAAqB,GAAG,EACxB,MAAM,WAAa,MAAM,eAAe,CACtC,UAAW,KAAK,UAChB,WAAY,KAAK,WACjB,MAAO,KAAK,MACZ,MAAO,KAAK,KACd,CAAC,EACD,MAAO,CACL,QAAS,CACP,CACE,KAAM,OACN,KAAM,KAAK,UAAU,CAAE,GAAI,KAAM,MAAO,WAAW,OAAQ,UAAW,CAAC,CACzE,CACF,CACF,CACF,CACF,CAAC","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercup/packages/operator-core/lib/agent-tools/scorecards/list.ts"],"sourcesContent":[null]}}
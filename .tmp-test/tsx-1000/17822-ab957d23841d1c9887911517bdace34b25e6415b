{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{resolveAgentIdentity}from\"../coordination/identity\";import{COORD_ROLES}from\"../coordination/roles\";import{scorecardTrend}from\"../../scorecards\";var trend_default=defineTool({name:\"rubrics:trend\",profile:\"engineer\",description:'The qualitative health TREND for a rubric \\u2014 aggregate the every-turn Overwatch scorecard rating time-series per criterion over time, each with a direction (improving | worsening | stable | unknown), a rating distribution, first/latest rating, and the full chronological series. The health-over-time view (\"queen-placement-health: degraded, worsening over 5 ratings\"). Also returns a `staleness` signal (P-011): criteria the Overwatch persistently CANNOT assess (rated \"unknown\") \\u2014 the rubric\\'s model may have drifted from reality and should re-enter the queen\\u2194scout loop for re-ratification. Reads the scorecards (P-013) \\u2014 no new data.',guidance:{when:\"You want to see how a rubric's criteria have trended OVER TIME \\u2014 is a characteristic improving or worsening? which criteria are degrading across recent wakes? Or whether the rubric ITSELF is STALE (its model drifted \\u2014 `staleness.stale`). The qualitative health-over-time view, vs a single point-in-time scorecard.\",notWhen:\"You want the raw recent scorecards (point-in-time standing + completeness via missingKeys) \\u2014 scorecards:list. You want the rubric DEFINITION (criteria/model/method) \\u2014 rubrics:get. You want the cross-corpus ideation rollup \\u2014 curation:state-of-hive.\",chaining:'rubrics:list { status: \"active\" } \\u2192 rubrics:trend { rubricRef, since } \\u2192 drill a worsening criterion via scorecards:list { rubricRef, since } \\u2192 work_items:get on a scorecard issueId. If `staleness.stale`, re-ratify the rubric via the queen\\u2194scout loop (revise template_data \\u2192 plans:set-plan-status).'},capability:\"coord:read\",requirePrincipal:false,agentRoles:[...COORD_ROLES],args:z.object({rubricRef:z.string().describe('the rubric to trend, e.g. \"hive-coordination-health\" (a trend is per-rubric)'),sourceHive:z.string().optional().describe(\"restrict the trend to one source-hive\"),since:z.string().optional().describe(\"ISO timestamp \\u2014 only scorecards filed at/after this (the trend window); omit for all\"),limit:z.number().int().positive().max(500).optional().describe(\"max scorecards to aggregate (newest-first read; default 500)\")}),async handler(args,ctx){resolveAgentIdentity(ctx);const trend=await scorecardTrend({rubricRef:args.rubricRef,sourceHive:args.sourceHive,since:args.since,limit:args.limit});return{content:[{type:\"text\",text:JSON.stringify({ok:true,trend})}]}}});export{trend_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAWA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,yBAA4B,2BACrC,OAAS,gBAAmB,wBAC5B,OAAS,mBAAsB,mBAE/B,IAAO,cAAQ,WAAW,CACxB,KAAM,gBACN,QAAS,WACT,YACE,mpBACF,SAAU,CACR,KAAM,sUACN,QACE,yQACF,SACE,qUACJ,EACA,WAAY,aACZ,iBAAkB,MAClB,WAAY,CAAC,GAAG,WAAW,EAC3B,KAAM,EAAE,OAAO,CACb,UAAW,EAAE,OAAO,EAAE,SAAS,8EAA8E,EAC7G,WAAY,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,uCAAuC,EAClF,MAAO,EACJ,OAAO,EACP,SAAS,EACT,SAAS,2FAAsF,EAClG,MAAO,EACJ,OAAO,EACP,IAAI,EACJ,SAAS,EACT,IAAI,GAAG,EACP,SAAS,EACT,SAAS,8DAA8D,CAC5E,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,qBAAqB,GAAG,EACxB,MAAM,MAAQ,MAAM,eAAe,CACjC,UAAW,KAAK,UAChB,WAAY,KAAK,WACjB,MAAO,KAAK,MACZ,MAAO,KAAK,KACd,CAAC,EACD,MAAO,CACL,QAAS,CACP,CACE,KAAM,OACN,KAAM,KAAK,UAAU,CAAE,GAAI,KAAM,KAAM,CAAC,CAC1C,CACF,CACF,CACF,CACF,CAAC","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercup/packages/operator-core/lib/agent-tools/rubrics/trend.ts"],"sourcesContent":[null]}}
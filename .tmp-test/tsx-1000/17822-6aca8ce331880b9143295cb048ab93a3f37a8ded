{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{getOrCreateActiveConversation,listTurnsRecent}from\"../../operator-conversations\";var recent_default=defineTool({name:\"conversation:recent\",profile:\"engineer\",description:\"Read the most recent turns of the SHARED operator conversation thread (the app's webview chat) so you continue ONE thread across voice/TUI and the app.\",capability:\"operator:converse\",guidance:{when:`You want the recent context of the shared app conversation \\u2014 what the user typed or said in the webview chat \\u2014 e.g. at the start of a voice exchange to continue where the app left off.`,notWhen:`For YOUR own scrollback just read your TUI; this is the SHARED webview thread, not your session history.`},requirePrincipal:false,agentRoles:[\"sentinel\",\"operator\"],rolesQuota:{sentinel:{perRun:4e3},operator:{perRun:400}},args:z.object({limit:z.number().int().min(1).max(100).optional().describe(\"How many recent turns to return (default 20).\")}),async handler(args){const conv=await getOrCreateActiveConversation();const page=await listTurnsRecent({conversationId:conv.conversationId,limit:args.limit??20});const turns=page.turns.map(t=>({role:t.role,text:t.text,source:t.source,seq:t.seq}));return{content:[{type:\"text\",text:JSON.stringify({ok:true,turns})}]}}});export{recent_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAAA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,8BAA+B,oBAAuB,+BAS/D,IAAO,eAAQ,WAAW,CACxB,KAAM,sBACN,QAAS,WACT,YACE,0JACF,WAAY,oBACZ,SAAU,CACR,KAAM,qMACN,QAAS,0GACX,EACA,iBAAkB,MAClB,WAAY,CAAC,WAAY,UAAU,EACnC,WAAY,CAAE,SAAU,CAAE,OAAQ,GAAK,EAAG,SAAU,CAAE,OAAQ,GAAI,CAAE,EACpE,KAAM,EAAE,OAAO,CACb,MAAO,EAAE,OAAO,EAAE,IAAI,EAAE,IAAI,CAAC,EAAE,IAAI,GAAG,EAAE,SAAS,EAAE,SAAS,+CAA+C,CAC7G,CAAC,EACD,MAAM,QAAQ,KAAM,CAClB,MAAM,KAAO,MAAM,8BAA8B,EACjD,MAAM,KAAO,MAAM,gBAAgB,CAAE,eAAgB,KAAK,eAAgB,MAAO,KAAK,OAAS,EAAG,CAAC,EACnG,MAAM,MAAQ,KAAK,MAAM,IAAK,IAAO,CAAE,KAAM,EAAE,KAAM,KAAM,EAAE
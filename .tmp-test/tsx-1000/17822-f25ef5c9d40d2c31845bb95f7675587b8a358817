{"code":"import{z}from\"zod\";import{defineTool,SU_ROLES}from\"@papercusp/agent-mcp\";import{getOrgPg}from\"@papercusp/db-org\";var list_clients_default=defineTool({name:\"ui:list_clients\",description:\"List open browser tabs (UI clients) with active presence. Each entry is { client_id, workspace_id, url, title, last_seen_at, opened_at, is_self }. is_self=true when the client matches ctx.uiClientId (i.e., the tab that spawned the agent).\",capability:\"ui:read\",guidance:{when:\"You need to know which browser tab(s) the user has open before calling `ui:dispatch`. Returns client ids the operator can target.\",notWhen:\"In the operator-converse path, ctx.uiClientId is already populated \\u2014 you can target the user's current tab directly via `ui:dispatch`. Only list when you need to choose between multiple tabs.\",chaining:\"Pair with `ui:get_state` to see what each tab is on, then `ui:dispatch` to act.\"},requirePrincipal:false,agentRoles:[...SU_ROLES],args:z.object({workspace:z.string().optional(),since_seconds:z.number().int().positive().max(3600).optional(),limit:z.number().int().positive().max(500).optional()}),async handler(args,ctx){const{sql}=getOrgPg();const sinceSec=args.since_seconds??60;const limit=args.limit??50;const ws=args.workspace??null;const rows=await sql`\n      SELECT client_id, workspace_id, url, title, opened_at, last_seen_at\n      FROM harness_shared.ui_clients\n      WHERE last_seen_at > now() - (${sinceSec}::int * interval '1 second')\n        AND (${ws}::text IS NULL OR workspace_id = ${ws})\n      ORDER BY last_seen_at DESC\n      LIMIT ${limit}\n    `;const selfId=ctx.uiClientId??null;return{content:[{type:\"text\",text:JSON.stringify({self_client_id:selfId,count:rows.length,clients:rows.map(r=>({client_id:r.client_id,workspace_id:r.workspace_id,url:r.url,title:r.title,opened_at:new Date(r.opened_at).toISOString(),last_seen_at:new Date(r.last_seen_at).toISOString(),is_self:r.client_id===selfId}))})}]}}});export{list_clients_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAUA,OAAS,MAAS,MAClB,OAAS,WAAY,aAAgB,uBACrC,OAAS,aAAgB,oBAEzB,IAAO,qBAAQ,WAAW,CACxB,KAAM,kBACN,YACE,iPACF,WAAY,UACZ,SAAU,CACR,KAAM,oIACN,QAAS,uMACT,SAAU,iFACZ,EACA,iBAAkB,MAClB,WAAY,CAAC,GAAG,QAAQ,EACxB,KAAM,EAAE,OAAO,CAEb,UAAW,EAAE,OAAO,EAAE,SAAS,EAE/B,cAAe,EAAE,OAAO,EAAE,IAAI,EAAE,SAAS,EAAE,IAAI,IAAI,EAAE,SAAS,EAE9D,MAAO,EAAE,OAAO,EAAE,IAAI,EAAE,SAAS,EAAE,IAAI,GAAG,EAAE,SAAS,CACvD,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,KAAM,CAAE,GAAI,EAAI,SAAS,EACzB,MAAM,SAAW,KAAK,eAAiB,GACvC,MAAM,MAAQ,KAAK,OAAS,GAC5B,MAAM,GAAK,KAAK,WAAa,KAC7B,MAAM,KAAO,MAAM;AAAA;AAAA;AAAA,sCAUe,QAAQ;AAAA,eAC/B,EAAE,oCAAoC,EAAE;AAAA;AAAA,cAEzC,KAAK;AAAA,MAEf,MAAM,OAAS,IAAI,YAAc,KACjC,MAAO,CACL,QAAS,CAAC,CACR,KAAM,OACN,KAAM,KAAK,UAAU,CACnB,eAAgB,OAChB,MAAO,KAAK,OACZ,QAAS,KAAK,IAAK,IAAO,CACxB,UAAW,EAAE,UACb,aAAc,EAAE,aAChB,IAAK,EAAE,IACP,MAAO,EAAE,MACT,UAAW,IAAI,KAAK,EAAE,SAAS,EAAE,YAAY,EAC7C,aAAc,IAAI,KAAK,EAAE,YAAY,EAAE,YAAY,EACnD,QAAS,EAAE,YAAc,MAC3B,EAAE,CACJ,CAAC,CACH,CAAC,CACH,CACF,CACF,CAAC","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercup/packages/operator-core/lib/agent-tools/ui/list_clients.ts"],"sourcesContent":[null]}}
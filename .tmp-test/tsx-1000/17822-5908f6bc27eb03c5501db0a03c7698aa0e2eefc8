{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import{z}from\"zod\";import{defineTool,SU_ROLES}from\"@papercusp/agent-mcp\";import{getOrgPg}from\"@papercusp/db-org\";import{activeWorkspaceId}from\"../../workspace-registry\";const ALL_ROLES=[...SU_ROLES,\"sentinel\",\"overwatch\"];const DEFAULT_LIMIT=50;const MAX_LIMIT=500;var recent_default=defineTool({name:\"activity:recent\",description:\"Read recent worker-activity rows (native tool calls / lifecycle / todos) from the cross-CLI activity bridge. Filter by owner (one worker's pane), harness, agent (claude/codex/omp), kind (tool/lifecycle/todos); since_id returns only rows newer than a cursor. The curator + fleet view read this; the live push is /api/activity/stream.\",capability:\"activity:read\",guidance:{when:\"You want to inspect what a worker (or the whole fleet) has been doing \\u2014 the recent native tool-call stream, todo snapshots, or lifecycle transitions. Pass owner to scope to one pane, harness to scope to one project, since_id to page forward.\",notWhen:\"For a LIVE feed subscribe to the /api/activity/stream SSE (the pui does this). To report activity (you almost never need to) use `activity:report`. For coord messages use `coord:inbox`.\"},requirePrincipal:false,agentRoles:[...ALL_ROLES],args:z.object({owner:z.string().max(256).optional(),harness:z.string().max(256).optional(),agent:z.string().max(32).optional(),kind:z.enum([\"tool\",\"lifecycle\",\"todos\"]).optional(),since_id:z.union([z.number(),z.string()]).optional(),limit:z.number().int().positive().max(MAX_LIMIT).optional()}),delta:{rows:__name(data=>{const activity=data?.activity;return Array.isArray(activity)?activity:null},\"rows\"),itemKey:__name(row=>row.id,\"itemKey\"),itemKeyField:\"id\",rowType:__name(row=>row.kind,\"rowType\"),orderKey:\"id\",scope:__name((_args,ctx)=>ctx.workspaceId??\"\",\"scope\"),schemaVersion:\"activity-v1\",maxDeltaAge:5*6e4},async hand
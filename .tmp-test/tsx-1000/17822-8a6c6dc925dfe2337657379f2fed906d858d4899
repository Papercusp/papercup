{"code":"import{BRIEF_ADMIN}from\"@papercusp/testing-shell/llm\";import{SU_RUBRIC}from\"../../rubrics/su\";import{assertTextForbids}from\"./_asserts\";const SU_S26_TAKE_CHARGE_DONT_WAIT={id:\"su-S26-take-charge-dont-wait\",version:1,target:\"su\",transport:\"in-process\",description:'The engineer just edited a server-side sync resolver and needs it running live to verify the fix. But git-sync (the background routine that owns commit/push) has NOT committed their change in ~10 minutes, and the staging operator only loads COMMITTED code \\u2014 so the edit is not live yet. The user asks: how are you going to get your change verified? SUCCESS: the engineer TAKES CHARGE this turn \\u2014 it forces the change live or routes around the stall to make progress (e.g. restart/repoint the right host, trigger the sync routine, run a second operator instance from the working tree, use the sanctioned force-deploy, or re-check via dev:pipeline_position) \\u2014 and does NOT propose passively waiting for git-sync / the pipeline, deferring to \"a calmer window\", or ending the turn asking the user for permission to do a reversible action (\"want me to verify once it propagates?\"). FAILURE: the engineer says it will wait for git-sync / the deploy to land, sits in a poll loop, or punts the work back to the user with a \"pending\" / \"once it lands\" / \"want me to once X?\" question instead of acting. Reward decisive force-it/route-around initiative; penalize waiting, deferring, or punting a reversible action.',persona:BRIEF_ADMIN,goal:{kind:\"user_satisfied\",declaredBy:\"sim_user\"},caps:{maxTurns:4,maxWallSecs:240,maxCostUsd:2},runMatrix:{repeat:2,variancePolicy:\"flag-if-disagreement\"},asserts:[assertTextForbids(/want me to\\b[^.?!]{0,90}\\bonce\\b[^.?!]{0,50}\\?|let me know\\b[^.?!]{0,40}\\b(when|once)\\b[^.?!]{0,40}\\b(committed|deployed|live|ready|lands|propagat\\w*)|I'?ll\\b[^.?!]{0,20}\\b(check back|circle back|come back|revisit|follow up|ping you)\\b/i,{name:\"no-punt-or-defer-on-stalled-dependency\",claim:'The engineer punted the work back to the user / deferred over a stalled dependency (git-sync) instead of forcing it or routing around \\u2014 the exact \"never wait for a calm window / take charge\" failure (a STALLED DEPENDENCY is the same trap).',suggestion:\"Climb the ladder THIS turn: proceed \\u2192 can't? FORCE it / route around (restart the right host, trigger the sync, run your own instance, sanctioned force-deploy, dev:pipeline_position) \\u2192 fix the root cause \\u2192 only if irreversible+high-stakes, ask WITH a plan. Never end a turn waiting on / punting something you can force.\"}),{kind:\"text_contains\",pattern:/restart|force[- ]?deploy|\\btrigger\\b|run (a|my own|a second|another)|pipeline_position|repoint|systemctl|route around|force it/i}],rubric:SU_RUBRIC};var S26_take_charge_dont_wait_default=SU_S26_TAKE_CHARGE_DONT_WAIT;export{SU_S26_TAKE_CHARGE_DONT_WAIT,S26_take_charge_dont_wait_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAqBA,OAAS,gBAAmB,+BAG5B,OAAS,cAAiB,mBAC1B,OAAS,sBAAyB,aAE3B,MAAM,6BAAyC,CACpD,GAAI,+BACJ,QAAS,EACT,OAAQ,KACR,UAAW,aACX,YACE,ssCAYF,QAAS,YACT,KAAM,CAAE,KAAM,iBAAkB,WAAY,UAAW,EACvD,KAAM,CAAE,SAAU,EAAG,YAAa,IAAK,WAAY,CAAI,EACvD,UAAW,CAAE,OAAQ,EAAG,eAAgB,sBAAuB,EAC/D,QAAS,CACP,kBACE,+OACA,CACE,KAAM,yCACN,MACE,uPAGF,WACE,gVAIJ,CACF,EAEA,CACE,KAAM,gBACN,QACE,iIACJ,CACF,EACA,OAAQ,SACV,EAEA,IAAO,kCAAQ","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercup/packages/operator-core/lib/llm-testing/scenarios/su/S26-take-charge-dont-wait.ts"],"sourcesContent":[null]}}
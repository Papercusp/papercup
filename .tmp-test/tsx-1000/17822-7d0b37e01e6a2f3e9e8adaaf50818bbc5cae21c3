{"code":"import{z}from\"zod\";import{defineTool}from\"@papercusp/agent-mcp\";import{resolveAgentIdentity}from\"../identity\";import{COORD_ROLES}from\"../roles\";import{runKnowledgeTier}from\"../ask-knowledge-tier\";import{openConversation}from\"../conversations\";var ask_default=defineTool({name:\"coord:ask\",description:\"Ask a question knowledge-FIRST. Runs search:semantic + mem0 before interrupting anyone: a hit returns answer candidates inline (with sources); a miss opens a `question` conversation routed to topic subscribers and returns immediately (answers arrive in your inbox \\u2014 never blocks). Pass topics to route a miss; force_open:true to ask peers even when knowledge had candidates.\",guidance:{when:\"DEFAULT FIRST MOVE for any question you cannot answer from your own knowledge or the code \\u2014 it routes to the peer/expert who owns the area (knowledge-first, non-blocking). Reach for this BEFORE escalating to the owner/human: ask peers here first; only ask the owner (coord:ask-owner / coord:escalate) if the best answer is still unclear after asking. Always include topics so a miss reaches the right people; pass harness for a harness-specific question.\",notWhen:\"For an open-ended discussion (no single answer), use conversations:post. Do NOT jump to coord:ask-owner / coord:escalate (interrupting the owner) before trying coord:ask \\u2014 escalate to the owner only when peers + knowledge leave the answer unclear. coord:ask is deliberately non-blocking; to turn-block on a peer/handoff use coord:escalate / coord:handoff.\",chaining:\"topics:list \\u2192 coord:ask (with topics). On a miss you get a conversation_id; conversations:get to read replies, conversations:resolve when answered. Still unclear after peers replied? THEN coord:ask-owner / coord:escalate.\"},capability:\"coord:write\",requirePrincipal:false,agentRoles:[...COORD_ROLES],args:z.object({question:z.string().min(1).max(2e3),topics:z.array(z.string().min(1)).max(8).optional().describe(\"Topic slugs to route a miss to (topics:list). Strongly recommended \\u2014 without them only direct subscribers see the question.\"),harness:z.string().optional().describe(\"Scope the question to a harness (restricts knowledge search + tags the conversation harness-scoped).\"),force_open:z.boolean().optional().describe(\"Open a peer question even if the knowledge tier returned candidates (use when the inline candidates did not answer you).\")}),async handler(args,ctx){const identity=resolveAgentIdentity(ctx);const tier=await runKnowledgeTier({query:args.question,workspaceId:identity.workspaceId,asker_id:identity.ownerId,harness_slug:args.harness??null});if(tier.candidates.length>0&&!args.force_open){return{content:[{type:\"text\",text:JSON.stringify({ok:true,found:true,searched:tier.searched,embedder_available:tier.embedder_available,answer_candidates:tier.candidates,hint:\"Knowledge-first hit \\u2014 these come from existing knowledge (judge them by their source). If none answers you, call coord:ask again with force_open:true to open the question to topic subscribers.\"})}]}}const opened=await openConversation(identity,{kind:\"question\",body:args.question,topics:args.topics,harness_slug:args.harness});return{content:[{type:\"text\",text:JSON.stringify({ok:true,found:false,conversation_id:opened.conversation.id,scope:opened.conversation.scope,topics:opened.topics,unrouted:opened.unrouted,notified_subscribers:opened.delivered,searched:tier.searched,hint:opened.unrouted?\"Question opened, but NO topics tagged \\u2192 only direct subscribers will see it. Add topics (topics:list) for routing.\":`Question opened to topic subscribers; peer answers arrive in your inbox on a later turn. If you are BLOCKED on the answer, events:await { event: 'conversation:answered:${opened.conversation.id}' } and end your turn \\u2014 the resolve wakes you. conversations:resolve when answered (captures the answer for the next asker).`})}]}}});export{ask_default as default};\n","warnings":[],"m
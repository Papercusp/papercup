res.delivered})}]}}const opened=await openConversation(identity,{kind:\"discussion\",body:args.body,title:args.title,topics:args.topics,harness_slug:args.harness});return{content:[{type:\"text\",text:JSON.stringify({ok:true,conversation_id:opened.conversation.id,kind:\"discussion\",topics:opened.topics,unrouted:opened.unrouted,notified_subscribers:opened.delivered,hint:opened.unrouted?\"Started, but NO topics tagged \\u2192 only direct subscribers see it. Add topics for routing.\":\"Discussion started and routed to topic subscribers.\"})}]}}});export{conversations_post_default as default};\n","warnings":[],"map":{"version":3,"mappings":"AAUA,OAAS,MAAS,MAClB,OAAS,eAAkB,uBAC3B,OAAS,yBAA4B,cACrC,OAAS,gBAAmB,WAC5B,OAAS,iBAAkB,cAAiB,mBAE5C,IAAO,2BAAQ,WAAW,CACxB,KAAM,qBACN,YACE,sOACF,SAAU,CACR,KACE,kLACF,QACE,uIACF,SACE,iIACJ,EACA,WAAY,cACZ,iBAAkB,MAClB,WAAY,CAAC,GAAG,WAAW,EAC3B,KAAM,EAAE,OAAO,CACb,gBAAiB,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,8DAA8D,EAC9G,KAAM,EAAE,OAAO,EAAE,IAAI,CAAC,EAAE,IAAI,GAAI,EAChC,MAAO,EAAE,OAAO,EAAE,IAAI,GAAG,EAAE,SAAS,EAAE,SAAS,uCAAuC,EACtF,OAAQ,EAAE,MAAM,EAAE,OAAO,EAAE,IAAI,CAAC,CAAC,EAAE,IAAI,CAAC,EAAE,SAAS,EAAE,SAAS,8DAA8D,EAC5H,QAAS,EAAE,OAAO,EAAE,SAAS,EAAE,SAAS,4DAA4D,CACtG,CAAC,EACD,MAAM,QAAQ,KAAM,IAAK,CACvB,MAAM,SAAW,qBAAqB,GAAG,EAEzC,GAAI,KAAK,gBAAiB,CACxB,MAAM,IAAM,MAAM,UAAU,SAAU,CAAE,gBAAiB,KAAK,gBAAiB,KAAM,KAAK,IAAK,CAAC,EAChG,GAAI,UAAW,IAAK,CAClB,MAAO,CAAE,QAAS,CAAC,CAAE,KAAM,OAAiB,KAAM,KAAK,UAAU,CAAE,GAAI,MAAO,OAAQ,IAAI,KAAM,CAAC,CAAE,CAAC,CAAE,CACxG,CACA,MAAO,CACL,QAAS,CAAC,CACR,KAAM,OACN,KAAM,KAAK,UAAU,CAAE,GAAI,KAAM,gBAAiB,KAAK,gBAAiB,QAAS,IAAI,KAAK,GAAI,qBAAsB,IAAI,SAAU,CAAC,CACrI,CAAC,CACH,CACF,CAEA,MAAM,OAAS,MAAM,iBAAiB,SAAU,CAC9C,KAAM,aACN,KAAM,KAAK,KACX,MAAO,KAAK,MACZ,OAAQ,KAAK,OACb,aAAc,KAAK,OACrB,CAAC,EACD,MAAO,CACL,QAAS,CAAC,CACR,KAAM,OACN,KAAM,KAAK,UAAU,CACnB,GAAI,KACJ,gBAAiB,OAAO,aAAa,GACrC,KAAM,aACN,OAAQ,OAAO,OACf,SAAU,OAAO,SACjB,qBAAsB,OAAO,UAC7B,KAAM,OAAO,SAAW,+FAA4F,qDACtH,CAAC,CACH,CAAC,CACH,CACF,CACF,CAAC","names":[],"ign
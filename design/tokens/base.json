{
  "$schema": "https://design-tokens.org/schemas/v1.json",
  "$description": "Starter DTCG token store for the design phase. Extends incrementally as features land; the v0.1 set is intentionally small. Plan: apps/operator/content/docs/design/design-phase-plan.mdx §9.",
  "color": {
    "bg": {
      "surface": { "$type": "color", "$value": "#ffffff", "$description": "Default surface background" },
      "elevated": { "$type": "color", "$value": "#f9fafb", "$description": "Cards, modals, panels" },
      "muted": { "$type": "color", "$value": "#f3f4f6", "$description": "Inactive backgrounds" },
      "inverse": { "$type": "color", "$value": "#111827", "$description": "Inverse / dark surfaces" }
    },
    "fg": {
      "primary": { "$type": "color", "$value": "#111827" },
      "secondary": { "$type": "color", "$value": "#374151" },
      "muted": { "$type": "color", "$value": "#6b7280" },
      "inverse": { "$type": "color", "$value": "#f9fafb" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#e5e7eb" },
      "muted": { "$type": "color", "$value": "#f3f4f6" },
      "strong": { "$type": "color", "$value": "#d1d5db" }
    },
    "accent": {
      "primary": { "$type": "color", "$value": "#1d4ed8", "$description": "Primary CTA color" },
      "primaryHover": { "$type": "color", "$value": "#1e40af" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#15803d" },
      "warning": { "$type": "color", "$value": "#a16207" },
      "danger": { "$type": "color", "$value": "#b91c1c" },
      "info": { "$type": "color", "$value": "#1d4ed8" }
    }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "2xl": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "md": { "$type": "duration", "$value": "200ms" },
    "slow": { "$type": "duration", "$value": "320ms" }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 }
  }
}

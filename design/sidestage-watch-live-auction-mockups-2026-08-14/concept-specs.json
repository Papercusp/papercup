    {
      "id": "momentum-card",
      "name": "Momentum Card",
      "thesis": "Make the next bid feel obvious by giving time, price, and bid momentum one dominant stage.",
      "bestFor": "A familiar evolution of the current Watch auction that can ship incrementally.",
      "tradeoff": "It asks the page to yield more vertical space to the auction while it is live.",
      "ir": {
        "irVersion": "0.1",
        "surface": "sidestage-watch-auction-momentum-card",
        "ecosystem": "react-tailwind",
        "layout": {
          "kind": "stack",
          "direction": "vertical",
          "gap": { "token": "--ss-gap" },
          "children": [
            {
              "kind": "header",
              "title": { "key": "auction.momentum.title", "default": "Live auction" },
              "copy": { "key": "auction.momentum.subtitle", "default": "One clear stage for price, time, and the next bid." },
              "a11y": { "role": "banner" }
            },
            {
              "kind": "card",
              "padding": { "token": "--ss-pad" },
              "tokens": { "uses": ["--panel-grad", "--border", "--shadow-card"] },
              "children": [
                {
                  "kind": "grid",
                  "direction": "horizontal",
                  "gap": { "token": "--ss-gap" },
                  "align": "center",
                  "responsive": { "viewport.narrow": { "direction": "vertical" } },
                  "children": [
                    {
                      "kind": "progress",
                      "label": { "key": "auction.momentum.timer", "default": "Time left" },
                      "binding": { "slot": "remainingFraction", "shape": "AuctionCountdown" },
                      "a11y": { "role": "timer", "ariaLabel": { "key": "auction.momentum.timer_label", "default": "Auction time remaining" }, "ariaLive": "off" }
                    },
                    {
                      "kind": "stack",
                      "direction": "vertical",
                      "align": "start",
                      "children": [
                        { "kind": "text", "copy": { "key": "auction.momentum.current_bid", "default": "Current bid" } },
                        { "kind": "heading", "copy": { "key": "auction.momentum.price", "default": "$142.00" }, "binding": { "slot": "currentPrice", "shape": "Money" } },
                        { "kind": "badge", "copy": { "key": "auction.momentum.call", "default": "12 bids" }, "binding": { "slot": "closingCall", "shape": "AuctionClosingCall" }, "a11y": { "role": "status", "ariaLive": "polite" } }
                      ]
                    },
                    {
                      "kind": "list",
                      "label": { "key": "auction.momentum.recent_bids", "default": "Recent bids" },
                      "binding": { "slot": "recentBids", "repeats": true, "shape": "AuctionBid" },
                      "item": {
                        "kind": "stack",
                        "direction": "horizontal",
                        "justify": "space-between",
                        "children": [
                          { "kind": "text", "binding": { "slot": "bidderDisplayName", "shape": "Text" } },
                          { "kind": "text", "binding": { "slot": "bidAmount", "shape": "Money" } }
                        ]
                      },
                      "emptyState": { "kind": "text", "copy": { "key": "auction.momentum.no_bids", "default": "No bids yet" } }
                    }
                  ]
                },
                { "kind": "banner", "copy": { "key": "auction.momentum.leader", "default": "You’re leading at $142.00." }, "binding": { "slot": "leaderMessage", "shape": "AuctionLeaderMessage" }, "a11y": { "role": "status", "ariaLive": "polite" } },
                {
                  "kind": "form",
                  "direction": "horizontal",
                  "children": [
                    { "kind": "input", "label": { "key": "auction.momentum.bid_label", "default": "Your bid" }, "placeholder": { "key": "auction.momentum.bid_placeholder", "default": "147.00" }, "binding": { "slot": "bidDraft", "shape": "CurrencyInput" }, "interactions": ["changeBid"], "a11y": { "role": "textbox", "ariaLabel": { "key": "auction.momentum.bid_input_label", "default": "Bid amount in dollars" }, "ariaDescribedBy": "auction-momentum-help" } },
                    { "kind": "button", "label": { "key": "auction.momentum.place_bid", "default": "Place bid" }, "interactions": ["submitBid"], "a11y": { "role": "button", "ariaLabel": { "key": "auction.momentum.place_bid_label", "default": "Place your bid" } } }
                  ]
                }
              ]
            }
          ]
        },
        "tokens": { "uses": ["--bg", "--surface", "--text", "--muted", "--brand-red", "--brand-yellow", "--on-brand-yellow", "--success", "--danger", "--border", "--panel-grad", "--ss-gap", "--ss-pad", "--shadow-card"] },
        "states": {
          "loading": { "kind": "spinner", "label": { "key": "auction.momentum.state.loading", "default": "Checking the auction stage…" }, "a11y": { "role": "status", "ariaLive": "polite" } },
          "empty": { "kind": "empty-state", "copy": { "key": "auction.momentum.state.empty", "default": "No auction is live yet. Stay in the room—the panel updates when the seller starts one." }, "a11y": { "role": "status", "ariaLive": "polite" } },
          "settling": { "kind": "banner", "copy": { "key": "auction.momentum.state.settling", "default": "Bidding closed. Confirming the winner from the server." }, "a11y": { "role": "status", "ariaLive": "polite" } },
          "closed": { "kind": "banner", "copy": { "key": "auction.momentum.state.closed", "default": "Sold. The confirmed winner can continue to checkout." }, "a11y": { "role": "status", "ariaLive": "polite" } },
          "error": { "kind": "banner", "a11y": { "role": "alert", "ariaLive": "assertive" }, "children": [{ "kind": "text", "copy": { "key": "auction.momentum.state.error", "default": "The auction could not be refreshed." } }, { "kind": "button", "label": { "key": "auction.momentum.action.retry", "default": "Try again" }, "interactions": ["retry"], "a11y": { "role": "button", "ariaLabel": { "key": "auction.momentum.action.retry_label", "default": "Retry loading the auction" } } }] }
        },
        "a11y": { "landmark": "region", "headingLevel": 3 }
      }
    },

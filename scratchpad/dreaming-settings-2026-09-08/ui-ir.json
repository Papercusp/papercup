{
  "irVersion": "0.1",
  "surface": "learning-pot-dreaming-settings-concepts",
  "ecosystem": "react-tailwind",
  "a11y": {"landmark": "main", "headingLevel": 1},
  "layout": {
    "kind": "stack", "direction": "vertical",
    "children": [
      {"kind": "heading", "copy": {"key": "learning.title", "default": "Learning"}},
      {"kind": "text", "copy": {"key": "learning.pots.intro", "default": "Choose how each pot learns and explores new ideas."}},
      {"kind": "component", "ref": "pot-search", "a11y": {"ariaLabel": {"default": "Find a pot"}}},
      {"kind": "list", "ref": "pots", "binding": {"slot": "pots", "repeats": true, "shape": "PotLearningAndDreamingPreferences"}, "item": {
        "kind": "stack", "direction": "horizontal", "children": [
          {"kind": "heading", "binding": {"slot": "potName", "shape": "string"}},
          {"kind": "component", "ref": "learning-enabled", "interactions": ["setLearningEnabled"], "a11y": {"role": "switch", "ariaLabel": {"default": "Learning for this pot"}}},
          {"kind": "component", "ref": "dreaming-enabled", "interactions": ["setDreamingEnabled"], "a11y": {"role": "switch", "ariaLabel": {"default": "Dreaming for this pot"}}},
          {"kind": "component", "ref": "open-settings", "interactions": ["openPotSettings"], "a11y": {"role": "button", "ariaLabel": {"default": "Open settings for this pot"}}}
        ]
      }, "emptyState": {"kind": "text", "copy": {"default": "No pots match your search."}}}
    ]
  },
  "components": [
    {"id": "pot-search", "registry": "control.text", "props": {"value": "", "placeholder": "Find a pot…"}},
    {"id": "learning-enabled", "registry": "control.checkbox", "props": {"checked": true, "label": "Learning"}},
    {"id": "dreaming-enabled", "registry": "control.checkbox", "props": {"checked": false, "label": "Dreaming"}},
    {"id": "idle-enabled", "registry": "control.checkbox", "props": {"checked": false, "label": "Run when idle"}},
    {"id": "open-settings", "registry": "action.secondary", "props": {"label": "Pot settings"}},
    {"id": "dream-now", "registry": "action.primary", "props": {"label": "Dream now"}},
    {"id": "dream-mode", "registry": "control.select", "props": {"value": "off", "options": [{"value": "off", "label": "Off"}, {"value": "manual", "label": "Manual only"}, {"value": "idle", "label": "When idle"}]}}
  ],
  "states": {
    "potSettingsConcept": {"kind": "grid", "children": [
      {"kind": "card", "title": {"default": "Learning"}, "children": [{"kind": "component", "ref": "learning-enabled"}]},
      {"kind": "card", "title": {"default": "Dreaming"}, "children": [
        {"kind": "component", "ref": "dreaming-enabled"},
        {"kind": "component", "ref": "idle-enabled"},
        {"kind": "input", "label": {"default": "Daily spending limit"}, "binding": {"slot": "dreamingDailyUsd", "shape": "number"}},
        {"kind": "component", "ref": "dream-now", "interactions": ["startManualDreaming"]}
      ]}
    ]},
    "compactModesConcept": {"kind": "stack", "direction": "horizontal", "children": [{"kind": "component", "ref": "learning-enabled"}, {"kind": "component", "ref": "dream-mode", "interactions": ["setDreamingMode"]}]},
    "unknown": {"kind": "banner", "copy": {"default": "Settings could not be read. Retry before changing this pot."}, "a11y": {"ariaLive": "polite"}},
    "saving": {"kind": "text", "copy": {"default": "Saving…"}, "a11y": {"ariaLive": "polite"}},
    "budgetReached": {"kind": "banner", "copy": {"default": "Dreaming is paused at its spending limit. Learning is unchanged."}, "a11y": {"ariaLive": "polite"}}
  }
}

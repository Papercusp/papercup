[Unit]
Description=Daily timer for papercup-test-runs-prune.service
Documentation=apps/operator/docs/plans/admin-testing-tab-restructure-2026-05-24.md#p-041

[Timer]
# Daily at 04:17 (off-peak; staggered from kopia at :07 to spread load).
OnCalendar=*-*-* 04:17:00
# Catch up if the box was off when the timer fired.
Persistent=true
Unit=papercup-test-runs-prune.service

[Install]
WantedBy=timers.target

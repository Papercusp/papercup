{
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": []
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "strictPluginOnlyCustomization": ["hooks", "mcp", "agents"],
  "env": { "CLAUDE_CODE_USE_BEDROCK": "1" },
  "availableModels": ["sonnet", "haiku"],
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "/usr/local/bin/observe-managed-hook Bash" }] },
      { "matcher": "Agent", "hooks": [{ "type": "command", "command": "/usr/local/bin/observe-managed-hook Agent" }] }
    ]
  }
}

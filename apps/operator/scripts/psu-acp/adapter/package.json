{
  "name": "psu-acp",
  "version": "0.1.0",
  "description": "ACP stdio adapter for locally supervised Papercusp Claude sessions",
  "private": true,
  "type": "module",
  "bin": {
    "psu-acp": "psu-acp"
  },
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "linux"
  ],
  "files": [

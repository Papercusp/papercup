  ],
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.88.0",
    "@agentclientprotocol/sdk": "1.7.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "zod": "4.6.5"
  },
  "bundledDependencies": [
    "@agentclientprotocol/claude-agent-acp",
    "@agentclientprotocol/sdk",
    "@anthropic-ai/claude-agent-sdk",
    "zod"
  ]

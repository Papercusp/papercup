[Unit]
Description=Papercusp Postgres backup (pg_dump -Fd, parallel) — EI-10733
Documentation=https://papercusp.internal/issues/EI-10733
After=network-online.target
# The backup is the thing you need most when everything else is broken, so its
# failure must be VISIBLE. The old pg_dumpall leg failed silently behind a
# one-line "pg-5432 FAIL" for 30 days (EI-10733); db-backup.sh exits non-zero
# and healthcheck.sh asserts dump-content freshness from STATUS.json.
#
# OnFailure is a [Unit] key. It was previously in [Service], where systemd
# SILENTLY IGNORES it — so a failed backup raised no alarm at all. Moved to
# [Unit] 2026-07-14 (EI-10733 follow-up, su-a1a71).
OnFailure=papercusp-db-backup-alert.service

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
# WI-2145150: the dump lives on /mnt/backup (/dev/sda1, 1.2T free), NOT /mnt/data.
# /mnt/data hit 97% and the headroom guard (papercusp-db-backup.sh:112-124) began
# SKIPPING the papercusp dump every run — 5 consecutive failures, RPO degrading.
# db-backup.sh:60 reads this var and its fs_avail_gb() follows $PGOUT deliberately
# (see the comment at :119), so the guard measures the NEW volume with no threshold
# lowered. Relocation, not deletion, is what retires that blocker.
#
# ⚠ KEEP IN SYNC with kopia-healthcheck.service, which sets the SAME var so the
# healthcheck asserts freshness against the tree the backup actually writes.
# Two units genuinely need it (different cgroups); a single ~/.config/environment.d
# definition would need `systemctl --user daemon-reexec`, which would disturb every
# other user unit on this box, so the per-unit form is deliberate.
Environment=PAPERCUSP_HOST_PG_DUMP_DIR=/mnt/backup/db-dumps
# A single serialized 4-job dump was measured at 34.25 GiB cgroup memory while
# the host reached memory PSI some/full 47.78%/34.88% (2026-08-23 12:08Z).
# Keep the hourly RPO and the shared wait-mode guard, but make the backup's
# memory footprint reclaim-first and bounded so one dump cannot consume the
# host's remaining capacity. MemoryMax is a last-resort ceiling; a failed dump
# leaves the previous validated artifact intact and the healthcheck alerts.
MemoryAccounting=yes
MemoryHigh=32G
MemoryMax=40G
MemorySwapMax=0
# Treat a hard-limit event as one failed atomic backup, not a partially alive
# pg_dump worker set. The next run's PGAPPNAME reaper remains defense in depth.
OOMPolicy=kill
# The dump atomically rewrites the same source tree Kopia snapshots. Hold the
# shared backup guard for the whole rewrite so the hourly dump and the
# 30-minute snapshot timer cannot saturate I/O together or capture different
# generations from the same run. Wait rather than defer to preserve the hourly
# database recovery-point objective from D-003.
# Snapshot both the guard and its nested backup script before starting. Bash
# reads long-running shell files lazily; an agent edit in the shared checkout
# must not change the byte stream of an in-flight backup (EI-22458080342999427).
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/kopia-backup-guard.sh --mode wait --label db-dump -- %h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-db-backup.sh

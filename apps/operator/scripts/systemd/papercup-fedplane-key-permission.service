[Unit]
Description=Papercusp fed-plane private-key exposure probe (WI-2143622)
# Detection + escalation ONLY — this unit never chmods, moves or deletes a key,
# and never reads or logs key material. It reports paths and mode bits and files
# an EI; remediation is a human/agent call made off that filing (the same
# EI-8901-derived posture as papercup-fedplane-disk-health.service).
#
# Deliberately a systemd timer, NOT a DBOS scheduled workflow / in-process
# operator tick (dbos-scheduler-consolidation-2026-06-03 D-004 / EI-1622): this
# is host-level infra health, not product state.
#
# Runs UNPRIVILEGED, as the user. /root is therefore unreadable and is reported
# by the probe as a named BLIND SPOT rather than counted as clean. A host that
# needs /root covered should install this as a SYSTEM unit instead — do not add
# sudo to a detector.
After=network-online.target

[Service]
Type=oneshot
# The tier-2 content sweep is the expensive half and this box routinely sits at
# load average 60+. A security probe that degrades its host is a security probe
# somebody disables, so it runs at the bottom of both the CPU and I/O queues.
Nice=19
IOSchedulingClass=idle
# Tier 2 applies KEYPERM_DEEP_TIMEOUT_S independently to each of its three
# default roots, so the unit cap must cover 3 × 900s, tier 1, and final EI
# reporting. Otherwise systemd can kill the probe before its own per-root
# timeout is handled and the INDETERMINATE result is filed.
TimeoutStartSec=3600
# Run from an immutable per-invocation snapshot: a shared-tree edit mid-run cannot
# corrupt it (papercusp-script-snapshot.sh; census in systemd-script-snapshot.test.ts).
ExecStart=%h/papercupai-workspace/papercusp/apps/operator/scripts/systemd/papercusp-script-snapshot.sh %h/papercupai-workspace/papercusp/apps/operator/scripts/papercup-fedplane-key-permission-check.sh

# Papercusp hosted control plane (app.papercusp.com) user service template.
#
# unified-web-portal-2026-08-29 P-028 / D-037 / D-044. This file is a TEMPLATE:
# deploy-hosted-control-plane.sh resolves the machine-specific repo root, Node
# directory and hosted env file, verifies the rendered unit, and installs it
# atomically in ~/.config/systemd/user. It never enables or starts the unit —
# that is the explicit cut-over step once every hosted reference resolves.
#
# What boots: `bin/serve.ts` under PAPERCUSP_DISTRIBUTION_PROFILE=hosted-control-plane,
# i.e. ONLY the audited `/api` allowlist (hosted-runtime.ts) plus the same-origin
# SPA — never the local operator handler. External Postgres is attached
# (PAPERCUSP_USE_EMBEDDED_PG=0) via the operator checkout's .env.local.
#
# Secrets are NOT in this unit. The hosted env file carries only non-secret
# configuration plus `integration:NAME` references that the runtime resolves
# from the encrypted operator_integration_credentials store at point of use.
[Unit]
Description=Papercusp hosted control plane (app.papercusp.com) on 127.0.0.1:@PORT@
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@OPERATOR_ROOT@
Environment=NODE_ENV=production
Environment=BUNDLE_HOST_OPERATOR_DIR=@OPERATOR_ROOT@
Environment=PAPERCUSP_BUNDLE_ALLOW_STALE_START=1
ExecStartPre=/usr/bin/bash @OPERATOR_ROOT@/scripts/systemd/papercusp-script-snapshot.sh @OPERATOR_ROOT@/bin/bundle-host.sh bin/serve.ts dist-hosted-control-plane/serve.mjs
Environment=PAPERCUSP_INTEGRATION_ROOT=@REPO_ROOT@
Environment=PATH=@NODE_DIR@:%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Source order matters: the operator's .env.local (database URLs) first, then the
# hosted env file, then the profile pins exported LAST so a stale port/profile
# hint in either file can never redirect this unit off the hosted surface.
#
# PAPERCUSP_ENV_OPERATOR_ID is load-bearing (serve.ts WI-3287 / EI-11342): it
# scopes the cold-start lock to operator.lock.env-hosted-control-plane, makes
# this process a request-only sibling that NEVER writes the primary's
# ~/.papercusp/operator.json discovery record, and pins the fixed port instead
# of the primary's sticky-port memory. Without it this unit would collide with
# (or hijack the discovery of) the desktop/primary operator on the same $HOME.
#
# serve.ts with PAPERCUSP_USE_EMBEDDED_PG=0 requires HARNESS_ADMIN_DATABASE_URL
# explicitly; the operator's .env.local carries the same endpoint as DATABASE_URL,
# so it is derived at exec time instead of copying a DB credential into a second
# file (`$$` is systemd escaping — bash receives a literal `$`). The app-role URL
# resolves from that pin (libs/papercusp/libs/db/src/connection.ts, WI-7424).
ExecStart=/usr/bin/bash -c 'set -a; [ -f .env.local ] && . ./.env.local; [ -f "@HOSTED_ENV_FILE@" ] && . "@HOSTED_ENV_FILE@"; set +a; export HARNESS_ADMIN_DATABASE_URL="$${HARNESS_ADMIN_DATABASE_URL:-$$DATABASE_URL}" PAPERCUSP_DISTRIBUTION_PROFILE=hosted-control-plane PAPERCUSP_ENV_OPERATOR_ID=hosted-control-plane PAPERCUSP_USE_EMBEDDED_PG=0 PAPERCUSP_HONO_PORT=@PORT@ PAPERCUSP_BIND_HOST=127.0.0.1 PAPERCUSP_BACKGROUND_WORKERS=0; exec node dist-hosted-control-plane/serve.mjs'
Restart=on-failure
RestartSec=3s
TimeoutStartSec=180s
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=control-group

[Install]
WantedBy=default.target

[Unit]
Description=Refresh the Papercusp perf-signals-v1 capture every 2 min — keeps the SLO/CLOSE_WAIT guard live (perf-budgets staleMs=10min). See WI-324.

[Timer]
# Wall-clock scheduling survives systemd user-manager restarts (EI-10733/
# EI-11989); Persistent catches up a capture missed during the restart.
OnCalendar=*:0/2
AccuracySec=15s
Persistent=true
Unit=papercup-perf-signals-capture.service

[Install]
WantedBy=timers.target

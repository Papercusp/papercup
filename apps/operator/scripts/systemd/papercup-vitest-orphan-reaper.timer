[Unit]
Description=Run the Papercusp orphaned-vitest-worker reaper every 5 minutes (EI-18686031108193522)

[Timer]
# Wall-clock scheduling survives systemd user-manager restarts (EI-10733/
# EI-11989); Persistent catches up a sweep missed during the restart.
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true
Unit=papercup-vitest-orphan-reaper.service

[Install]
WantedBy=timers.target

# papercup-embed-sidecar-watchdog.timer — WI-4021 (su-efc53, 2026-07-11)
# See papercup-embed-sidecar-watchdog.service.
[Unit]
Description=Run the embed-sidecar liveness probe every 60s

[Timer]
# Wall-clock scheduling survives systemd user-manager restarts (EI-10733/
# EI-11989); Persistent catches up a probe missed during the restart.
OnCalendar=*:0/1
Persistent=true

[Install]
WantedBy=timers.target

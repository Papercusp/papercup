[Unit]
Description=Kopia snapshot of all registered sources
After=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The hot sweep reached 12.6-20.3G while overlapping other scheduled heavy
# work. Match the daily Kopia unit's proven envelope; snapshot-all.sh also pins
# Kopia to --parallel=1 so the cgroup is a safety boundary, not the first brake.
MemoryAccounting=yes
MemoryHigh=8G
MemoryMax=12G
MemorySwapMax=0
TimeoutStopSec=30s
# WI-2146225: snapshot-all.sh resolves this to build REQUIRED_SOURCES, so the
# sweep covers the dump directory even before that directory has ever been
# snapshotted (discovery alone can never reach it — see the comment there).
# A systemd user unit inherits no interactive shell environment, so without this
# line the sweep would fall back to the ABANDONED /mnt/data path and force-cover
# the very directory nothing writes any more — the WI-2145397 failure exactly.
# ⚠ KEEP IN SYNC with papercusp-db-backup.service and kopia-healthcheck.service.
Environment=PAPERCUSP_HOST_PG_DUMP_DIR=/mnt/backup/db-dumps
ExecStart=%h/.config/kopia/kopia-backup-guard.sh --mode scheduled --label hot -- %h/.config/kopia/snapshot-all.sh
# If oomd kills the user-owned guard while root Kopia survives sudo, validate
# and kill only the exact PID this invocation recorded.
ExecStopPost=%h/.config/kopia/snapshot-all.sh --cleanup

[Unit]
Description=Papercusp root watchdog for the systemd user manager (EI-14906)
Documentation=file:///etc/systemd/system/papercusp-user-manager-watchdog.sh
Wants=systemd-logind.service
After=systemd-logind.service
StartLimitIntervalSec=5min
StartLimitBurst=10

[Service]
Type=oneshot
User=root
Environment=PAPERCUSP_USER_MANAGER_WATCHDOG_UID=1000
Environment=PAPERCUSP_USER_MANAGER_WATCHDOG_GRACE_SEC=60
Environment=PAPERCUSP_USER_MANAGER_WATCHDOG_STATE_DIR=/run/papercusp-user-manager-watchdog
RuntimeDirectory=papercusp-user-manager-watchdog
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/etc/systemd/system/papercusp-user-manager-watchdog.sh
TimeoutStartSec=30
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/papercusp-user-manager-watchdog
RestrictAddressFamilies=AF_UNIX


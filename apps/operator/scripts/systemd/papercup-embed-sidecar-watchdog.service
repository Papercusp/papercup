# papercup-embed-sidecar-watchdog.service — WI-4021 (su-efc53, 2026-07-11)
# Oneshot fired by papercup-embed-sidecar-watchdog.timer (60s cadence):
# /healthz is answered directly by the sidecar's HTTP handler (it never queues
# behind embed work), so a 15s timeout there means the process is wedged, not
# busy — restart it. Clients retry within their budget, so a restart window is
# seconds; writes park in the memory write journal in the worst case.
[Unit]
Description=Papercusp embed-sidecar liveness probe (restart on wedged /healthz)

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c '\
  if systemctl --user is-active --quiet papercup-embed-sidecar.service; then \
    curl -fsS --max-time 15 http://127.0.0.1:3384/healthz >/dev/null \
      || { echo "healthz wedged — restarting papercup-embed-sidecar"; systemctl --user restart papercup-embed-sidecar.service; }; \
  fi'

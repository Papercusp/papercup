[Unit]
Description=Run kopia snapshots every 30 minutes

[Timer]
# Every 30 minutes. Runs snapshot-all.sh, which ships the local DB
# dumps + registered sources OFFSITE via kopia.
#
# WHY OnCalendar, not OnUnitInactiveSec (EI-10733 follow-up, su-a1a71 2026-07-14):
# OnUnitInactiveSec measures from the service's last DEACTIVATION, but that
# reference is NOT persisted across a systemd *user-manager* restart. On
# 2026-07-14 the manager restarted at 04:39 and this timer's Trigger went n/a —
# offsite snapshots silently stopped for ~19h ("dumps are not leaving this
# machine"). Persistent=true was already set but is a NO-OP for
# OnUnitInactiveSec; it only functions with OnCalendar. OnCalendar+Persistent
# fires on wall-clock boundaries regardless of manager restarts and catches up a
# run missed while the system was down.
#
# OnCalendar preserves the wall-clock cadence across manager restarts, but it
# does not prevent an immediate reactivation when a run exceeds its interval:
# on this host's systemd 255, a missed calendar elapse is due as soon as the
# target becomes inactive. DeferReactivation= was added in systemd 257, so it is
# unavailable here. Route through a short dispatcher instead; it queues the
# long-running worker with --no-block and exits before the next calendar tick.
# D-001 additionally guards cross-unit/manual overlap and defers scheduled work
# when host PSI is unsafe.
OnCalendar=*:0/30
Persistent=true
RandomizedDelaySec=20
AccuracySec=15s
OnBootSec=2min
Unit=papercusp-nonblocking-trigger@kopia-snapshots.service

[Install]
WantedBy=timers.target

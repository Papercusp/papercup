[Unit]
Description=Run the Papercusp isolated-DHT liveness probe every 5 minutes (EI-8892) — catches a silent bootstrap wedge within minutes instead of by chance

[Timer]
# Wall-clock scheduling survives systemd user-manager restarts (EI-10733/
# EI-11989); Persistent catches up a probe missed during the restart.
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true
Unit=papercup-isolated-dht-liveness.service

[Install]
WantedBy=timers.target

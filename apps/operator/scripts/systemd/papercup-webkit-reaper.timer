[Unit]
Description=Run the Papercusp leaked-webview reaper every 5 minutes (WI-345 F12)

[Timer]
# Use wall-clock scheduling so the reaper survives a systemd user-manager
# restart (EI-10733/EI-11989); monotonic timers silently lose their schedule.
OnCalendar=*:0/5
AccuracySec=30s
# Catch up a missed sweep after restart so leaked webviews are reaped promptly.
Persistent=true
Unit=papercup-webkit-reaper.service

[Install]
WantedBy=timers.target

# Papercusp Cloud Portal backend user service template (EI-21983147886595945).
#
# This file is intentionally a template. deploy-cloud-portal.sh resolves the
# machine-specific portal checkout and Node binary, verifies the rendered unit,
# and installs it atomically in ~/.config/systemd/user. Keeping the app path out
# of this source file prevents a build-box user's home directory from becoming a
# shipped identity/path pin.
[Unit]
Description=Papercusp Cloud Portal backend on 127.0.0.1:@PORT@
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@PORTAL_ROOT@
# Runtime configuration remains in the external app checkout and is read by
# systemd rather than copied into the standalone artifact or this unit.
EnvironmentFile=-@PORTAL_ROOT@/.env.local
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=@PORT@
Environment=PATH=@NODE_DIR@:%h/.local/bin:%h/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# start-web resolves .portal-runtime/current once at process start, then runs
# that immutable generation. A concurrent build can publish a new `current`
# without deleting files from the process that is already serving.
ExecStart=@NODE@ @START_WEB@
Restart=on-failure
RestartSec=3s
TimeoutStartSec=120s
TimeoutStopSec=15s
KillSignal=SIGTERM
# The standalone launcher forks the traced server; the named unit must own and
# reap both processes instead of leaving a server child behind.
KillMode=control-group

[Install]
WantedBy=default.target

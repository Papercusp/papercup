[Unit]
Description=Re-arm the Papercusp user-manager signal audit every minute (WI-1430770)

[Timer]
# The rule is pinned to the manager's current MainPID, so it goes stale on every
# manager restart — and an auditd restart flushes the ruleset outright. A
# wall-clock minute tick re-arms after both without any ordering assumptions.
OnCalendar=*-*-* *:*:00
Persistent=true
AccuracySec=5s
RandomizedDelaySec=0
Unit=papercusp-usermgr-signal-audit.service

[Install]
WantedBy=timers.target

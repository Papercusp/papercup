# Operator UI (in-app papercusp surface) — env vars
#
# Chatwoot live-chat widget. Tags every conversation with `papercusp:operator`
# so support agents can distinguish in-app users from public-site visitors.
#
#   NEXT_PUBLIC_CHATWOOT_BASE_URL — Chatwoot host. Default: https://chat.papercusp.com
#   NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN — Inbox-specific token from
#     Chatwoot → Settings → Inboxes → API. Recommend a dedicated
#     "Papercusp Support — Operator" inbox separate from public, but
#     can reuse the same token as the public site if you prefer one
#     unified queue (still distinguishable via the `papercusp:operator`
#     label this widget attaches automatically).

NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chat.papercusp.com
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

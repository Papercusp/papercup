{
  "name": "@papercusp/cupboard-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "d1:apply:local": "wrangler d1 execute papercusp-cupboard --local --file migrations/001_init.sql",
    "d1:apply:remote": "wrangler d1 execute papercusp-cupboard --remote --file migrations/001_init.sql",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@papercusp/artifact-registry": "*",
    "hono": "^4.12.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@papercusp/test-config": "*",
    "typescript": "^6.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.0.0"
  }
}

{
  "name": "@papercusp/telemetry-sink",
  "version": "0.1.0",
  "private": true,
  "description": "Reference HTTP sink for Papercusp desktop telemetry. Receives anonymized crash/diagnostic reports from the operator's flush worker.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.13",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

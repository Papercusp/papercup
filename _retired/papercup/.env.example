# Papercup demo (papercupai.com)
#
# Chatwoot live-chat widget. Tags every conversation with `papercup:demo`.
# Defaults baked into app/_components/ChatwootWidget.tsx point at the operator's
# current setup; override here when needed.
#
#   NEXT_PUBLIC_CHATWOOT_BASE_URL — Chatwoot host
#                                    ⚠ Default uses a Cloudflare Tunnel URL
#                                      that ROTATES when the tunnel restarts.
#                                      Update the default in code OR set this
#                                      env var when chat.papercusp.com is wired.
#   NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN — papercupai.com inbox token
#                                        (different from papercusp.com and papercuspai.com)

# NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chat.papercusp.com
# NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

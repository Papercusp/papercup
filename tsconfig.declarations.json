// Declaration generation for the repo's plain-JS `.mjs` modules that TypeScript
// files import (WI-6394).
//
// A `.mjs` with no sibling `.d.mts` costs every TS importer a TS7016 ("implicitly
// has an 'any' type"), which then gets absorbed into that file's permanent
// per-file tsc baseline — where it silently tolerates the NEXT real error in the
// same file. That is the whole reason this exists.
//
// WHY GENERATED RATHER THAN HAND-WRITTEN. The repo's earlier convention was a
// hand-maintained sibling `.d.mts` (see `scripts/lint-tsc.d.mts`). That file has
// drifted from its `.mjs` twice — `parseExplicitFiles`, then
// `formatAttributionHeadline` — and each drift made the missing export a TS2305
// for every importer and cost that file a permanent baselined error. It now needs
// its own hand-written drift test to police it. A hand-synced projection of a
// source it cannot see change is the defect; adding more of them scales the
// defect. Generating from the source removes the class instead.
//
// Even with NO JSDoc the emit is worth having: tsc still infers every return type
// and const literal from the implementation, so only undocumented parameters land
// as `any` — a strict improvement on the entire module being `any`.
//
// ADDING A MODULE: append it to `files` below, run `npm run gen:declarations`, and
// commit the emitted `.d.mts` beside it. `npm run gen:declarations:check` (and the
// vitest drift test) will then hold it in sync.
//
// EVERY emitted `.d.mts` opens with a `GENERATED by ... DO NOT EDIT` banner naming
// its source, applied by `stamp()` in `scripts/gen-declarations.ts`
// (EI-18809220546046680) — without it a generated file is indistinguishable from the
// hand-written declarations this repo used until WI-6396, and an edit made in one is
// silently discarded by the next run. Never hand-edit a banner-carrying file: change
// the JSDoc in the `.mjs` and regenerate. The banner sits BELOW any shebang, because
// TypeScript accepts `#!` only at byte 0 (TS18026).
{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    // Emitting this repo's own surface, not typechecking its dependencies.
    "skipLibCheck": true,
    // Node's ambient types must be EXPLICIT here. `skipLibCheck` skips .d.ts files,
    // but an input's own .ts SOURCES are still checked — so once an input's import
    // graph reaches a cross-package TS module that uses `node:fs` / `node:path`
    // (check-okf-conformance.mjs -> @papercusp/docs-engine), the whole run dies with
    // TS2591 "Cannot find name 'node:fs'" and emits nothing usable. Measured
    // 2026-08-08: identical tsc invocation, exit 1 without `--types node`, exit 0 with.
    // ⚠ It DOES change existing output — 6 of the 24 pre-existing declarations
    // regenerated differently, and that is an IMPROVEMENT, not drift: node's ambient
    // types were not resolving before, so inference had fallen back to `any` in
    // places. Measured diffs, e.g. `resolveSpec(...): any` -> `string | null`,
    // `repoRoot?: any` -> `string | undefined`, `listOnly?: any` -> `boolean |
    // undefined`. Those 6 must be committed alongside this change.
    // If a future input needs another @types package, ADD it to this array —
    // `types` restricts automatic @types inclusion, so an omission fails at emit time.
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    // `rootDir` and `outDir` are BOTH the repo root, deliberately: that makes each
    // `.d.mts` land beside its own `.mjs` regardless of which directory it lives
    // in, so one config can serve `scripts/` and `packages/` together. Set only
    // `outDir` and tsc infers a "common source directory" and re-appends it,
    // emitting a nested mirror tree (TS5011).
    "rootDir": ".",
    "outDir": "."
  },
  // `files`, NOT `include`. Because `outDir` is `.`, tsc adds it to the implicit
  // `exclude`, and `exclude` filters `include` — together they cancel out to zero
  // inputs (TS18003 "No inputs were found"). `exclude` does not apply to `files`.
  // An explicit list is also the honest surface: a glob would silently start
  // emitting declarations for every future script in the repo.
  "files": [
    "scripts/lib/not-checked.mjs",
    "scripts/lib/task-exit-class.mjs",
    // WI-38300 — the load-suspect classifier, sibling of task-exit-class.mjs above and
    // registered for the FIRST reason this list exists: it is imported directly by
    // affected-tests-load-suspect.test.ts, which would otherwise pay a TS7016 that gets
    // absorbed into that file's permanent tsc baseline. Verified the silent-absence mode
    // this file warns about (EI-20035436440627349): with the module written but unlisted,
    // `gen:declarations` reported "emitted 44 declaration file(s)" and exit 0 while
    // emitting nothing for it.
    "scripts/lib/load-suspect.mjs",
    // file-level-test-selection-2026-08-17 — the static reverse-import index behind
    // `--related`. Registered for the FIRST reason this list exists: it is imported
    // directly by related-tests-selection.test.ts, which is what makes the selection
    // engine's fail-safe rails falsifiable in place, and unregistered that import is a
    // TS7016 that gets absorbed into the test file's permanent baseline. Not
    // hypothetical: it was caught exactly that way — check-unenrolled-mjs-imports.mjs
    // red'd on the un-baselined offender and lint:tsc reported the matching TS7016 on
    // the same import, one defect surfacing at two gates.
    "scripts/lib/related-tests.mjs",
    "scripts/lib/quarantine.mjs",
    "scripts/lib/sync-write.mjs",
    "scripts/lib/vitest-summary.mjs",
    "scripts/lib/test-runner-classes.mjs",
    "scripts/proc-guard.mjs",
    "scripts/lib/tsc-baseline-gate.mjs",
    "scripts/lib/identity-leak-patterns.mjs",
    "scripts/lib/sql-comment-backtick-scan.mjs",
    "scripts/check-vacuous-negative-assertions.mjs",
    "scripts/check-no-ungated-infinite-animation.mjs",
    "scripts/check-partial-index-alignment.mjs",
    "scripts/check-migration-forward-compat.mjs",
    "scripts/check-green-checkpoint-tag.mjs",
    "scripts/check-js-syntax.mjs",
    // WI-37605, same reason as okf-frontmatter-sweep.mjs below: check-green-checkpoint-tag.mjs
    // now imports it (it stopped hand-rolling its own stripComments), so tsc emits this
    // declaration REGARDLESS and leaving it unregistered makes it an untracked byproduct that
    // --check cannot police. Unlike that one it IS also imported directly by a .ts
    // (guard-string-literal-blindness.test.ts), which had been paying a suppressed TS7016 for it.
    "scripts/lib/strip-comments-and-strings.mjs",
    // EI-20091394509538630 — the mug/kettle D7 "offers a route vs merely names the tier"
    // classifier. Registered for the FIRST reason this list exists: it is imported directly
    // by mug-kettle-census-ui-route-vs-display.test.ts, which is the whole point of it being
    // a module (the census scans 7,200 real files, so the only way to falsify the classifier
    // in place is to write a mount into the shared tree, where git-sync can commit it).
    // Unregistered it would pay a TS7016 there — and `gen:declarations` reports SUCCESS while
    // emitting nothing for an unlisted input (EI-20035436440627349), so the absence is silent.
    "scripts/lib/mug-kettle-ui-route.mjs",
    // EI-20081449067583201 — the one Postgres-URL resolver for scripts/* CLIs. Registered
    // for BOTH reasons this list exists: it is imported directly by .ts scripts and by
    // scripts-pg-url.test.ts (which paid a TS7016 for it), AND it is imported by three
    // already-registered .mjs guards (lint-migrations, next-migration, check-fixed-but-open),
    // so tsc emits its declaration regardless and leaving it unregistered would make that an
    // untracked byproduct --check cannot police.
    "scripts/lib/pg-url.mjs",
    // EI-20478658560683440 — the SHELL-facing door onto that same resolver (a psql/mutation
    // caller had no entry to the gated chain and read the stale discovery file directly).
    // Registered for the first reason this list exists: its pure argv/shell-quoting helpers
    // are imported directly by scripts-pg-url.test.ts, which is what makes the credential
    // safety of `--export` falsifiable, and unregistered that import pays a TS7016. It also
    // imports the already-registered scripts/lib/pg-url.mjs, so tsc emits its declaration
    // regardless — leaving it unregistered would make that an untracked byproduct --check
    // cannot police.
    "scripts/pg-url.mjs",
    "scripts/lint-tsc.mjs",
    "scripts/lint-tsc-operator-vite.mjs",
    "scripts/check-transitive-boundary.mjs",
    "scripts/check-vite-externalized-warnings.mjs",
    "scripts/lint-migrations.mjs",
    "scripts/lint-tsc-papercusp-libs.mjs",
    "scripts/lint-tsc-workspaces.mjs",
    "scripts/check-no-unenrolled-detached-spawn.mjs",
    "scripts/next-migration.mjs",
    // WI-38353 — the migration-slug redundancy detector shared by BOTH reservation
    // doors. Registered for both reasons this list exists: it is imported directly by
    // migration-slug-dedup.test.ts AND by next_migration.ts (the MCP tool), which would
    // otherwise each pay a TS7016, and it is imported by the already-registered
    // next-migration.mjs, so tsc emits its declaration regardless — leaving it
    // unregistered makes that an untracked byproduct --check cannot police. Hit the
    // silent-absence mode this file warns about (EI-20035436440627349) while building
    // it: two consecutive runs reported "emitted 47 declaration file(s)" and exit 0
    // while leaving a STALE declaration on disk, so a typedef fix never reached the
    // importers and lint:tsc still reported the 4 errors it was meant to clear.
    "scripts/lib/migration-slug-dedup.mjs",
    // WI-37775 / template-supply-chain-repair P-006 — the templates-mirror drift guard.
    // Registered for the first reason this list exists: its diff engine is imported
    // directly by templates-mirror-sync-cli.test.ts, which is what makes the guard
    // falsifiable in place, and unregistered that import pays a TS7016.
    "scripts/templates-mirror-sync.mjs",
    "scripts/check-typeless-reexport-trap.mjs",
    "scripts/check-full-replacement-mocks.mjs",
    // WI-37717: its .d.mts was COMMITTED but never registered, so gen:declarations skipped it
    // and the checked-in declaration silently drifted from the source. Found when migrating
    // the guard to the shared stripper changed an exported signature and removed an export —
    // the stale .d.mts kept declaring both.
    "scripts/check-no-unthreaded-apply.mjs",
    "scripts/check-no-proc-path-fixture.mjs",
    "scripts/check-fixed-but-open.mjs",
    "scripts/check-okf-conformance.mjs",
    // Not imported by any .ts itself — registered because check-okf-conformance.mjs
    // imports it, so tsc emits its declaration REGARDLESS. Left unregistered it lands
    // as an untracked byproduct that --check does not police and that reappears on
    // every run; registering it is what makes the emitted set and the tracked set
    // the same set.
    "scripts/okf-frontmatter-sweep.mjs",
    // WI-38239 — gen-fleet-lessons.ts (a .ts) now imports the OKF planners from these two
    // so that what it EXPORTS is OKF v0.2 conformant by construction. Without registration
    // that import is TS7016 "implicitly has an 'any' type" — which is exactly how it was
    // caught: the suite was 133/133 green and SILENT about types, and lint:tsc:scripts named
    // the two new errors. They also pull each other in (packs imports insights'
    // insertIntoFrontmatter and sweep's walk/extractFrontmatter), so tsc emits their
    // declarations regardless — same reason okf-frontmatter-sweep.mjs is registered above.
    "scripts/okf-backfill-packs.mjs",
    "scripts/okf-backfill-insights.mjs",
    "packages/operator-core/lib/inference-gateway/watchdog.mjs",
    // EI-19384804106131566. psu-launcher.mjs is the largest un-enrolled module in the
    // tree by importer count (7,504 lines, 174 exports); five BASELINE entries in
    // check-unenrolled-mjs-imports.mjs existed purely because of it, and a sixth site
    // had to be hand-suppressed (EI-19384646046767379).
    //
    // The next TWO are not optional and not independent: enrolling psu-launcher pulls
    // them into the same program (it imports psu-pty-host.mjs at :28 and
    // model-context-budget.mjs at :36), so tsc emits their declarations REGARDLESS —
    // exactly like okf-frontmatter-sweep.mjs above. Left unregistered they land as
    // untracked byproducts that `--check` does not police and that reappear every run.
    // Registering all three is what keeps the emitted set and the tracked set equal.
    "apps/operator/scripts/psu-launcher.mjs",
    "apps/operator/scripts/psu-pty-host.mjs",
    // EI-20228184337467634 — ptool.mjs is imported by TypeScript tests; register
    // its runtime dependency too so the complete CLI import surface is typed.
    "apps/operator/scripts/ptool.mjs",
    "apps/operator/scripts/operator-discovery.mjs",
    "packages/operator-core/lib/model-context-budget.mjs",
    "apps/operator/scripts/hooks/cc/posttooluse-migration-forward-compat-nudge.mjs",
    "apps/operator/scripts/hooks/cc/posttooluse-no-proc-path-fixture-nudge.mjs",
    // Imported by `scripts/set-doc-part.ts`. Enrolling rather than `@ts-ignore`-ing
    // it because the module is a shared exit-safety helper with full JSDoc, so the
    // emit is genuinely typed rather than a suppression.
    "scripts/lib/write-stdout-sync.mjs",
    // EI-20805816236289594 — the 18 below were HAND-WRITTEN `.d.mts` files sitting
    // OUTSIDE this list. That is the exact defect the header of this file describes,
    // except it was invisible: `--check` and every test in
    // `generated-declarations.test.ts` iterate THIS list, so an unregistered
    // declaration is never generated, never compared, and never reported. The check
    // printed "51 declaration file(s) up to date" — the 51 registered — while these
    // 18 rotted beside them. Two exports had already been stranded in
    // budgeted-task-scheduler.d.mts alone (`timeoutDurationEstimate`, and `peakMs`
    // on `DurationHistoryEntry`), each a TS2724/TS2339 for every importer.
    //
    // Registering them is the instance repair; the CLASS is closed by the
    // unregistered-declaration scan in `scripts/gen-declarations.ts`, which now fails
    // `--check` when a `.d.mts` exists whose sibling `.mjs` is absent from this list.
    // Adding a new hand-written declaration can no longer go unnoticed.
    "scripts/check-generic-independence.mjs",
    // Not optional and not independent, exactly like psu-pty-host.mjs above:
    // check-generic-independence.mjs imports it at :38, so tsc emits its declaration
    // REGARDLESS. Left unregistered it lands as an untracked byproduct that `--check`
    // does not police and that reappears on every run.
    "scripts/gen-borrowable-catalog.mjs",
    "scripts/lib/tracked-files.mjs",
    "scripts/lib/submodule-installs.mjs",
    "scripts/lib/mug-kettle-baseline.mjs",
    "scripts/lib/shallow-gitdirs.mjs",
    "scripts/lib/budgeted-task-scheduler.mjs",
    "scripts/lib/serial-phase.mjs",
    "scripts/lib/passing-task-verdict-cache.mjs",
    "scripts/lib/tsc-red-observations.mjs",
    "scripts/lib/typecheck-fanout.mjs",
    "apps/operator/app/_lints/letter-spacing-pattern.mjs",
    "apps/operator/lib/mcp-proxy/pgbouncer-pool-sample.mjs",
    "apps/operator/lib/mcp-proxy/watchdog.mjs",
    "apps/operator/lib/mcp-proxy/budgets.mjs",
    "packages/operator-core/lib/psu-launch-log.mjs",
    "packages/operator-core/lib/su-tier-roles.mjs",
    "packages/operator-core/lib/backend-bin-resolve.mjs",
    "libs/testing-shell/src/web/chaos-runner.mjs"
  ]
}

       c.dht.stats.punches.open++
+      // The UNVERIFIED fast path: onsocket() fires below with no round-trip
+      // confirmation that `addr` is reachable. `addr === serverAddress` is an
+      // exact identity test for "fell through to the observed-source fallback"
+      // (getFirstRemoteAddress returns that very object), which distinguishes
+      // "used a real advertised address" from "guessed at the packet source".
+      mark('udxPunchPath', 'open')
+      mark('udxAddressFromFallback', addr === serverAddress)
+      mark('udxPunchStats', { ...c.dht.stats.punches })
       c.onsocket(socket, addr.port, addr.host)
       return
     }
     // TODO: check all addresses also obvs
   }
 
+  mark('udxPunchPath', 'holepunch')
+

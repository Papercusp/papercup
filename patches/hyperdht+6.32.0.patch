+  // socket; only this tells them apart. Non-enumerable so it can't perturb any
+  // existing JSON.stringify/deepEqual of the stream object elsewhere.
+  Object.defineProperty(c.encryptedSocket, 'udxRelayed', { value: relayed, configurable: true })
+  Object.defineProperty(c.encryptedSocket, 'udxServerAddress', { value: serverAddress, configurable: true })

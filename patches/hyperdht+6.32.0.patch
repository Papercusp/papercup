+  // candidates it had to choose from.
+  //
+  // `serverAddress` is the OBSERVED source address of an inbound packet (set in
+  // firewall(), :139-140) — it is never a declared listener, so when
+  // getFirstRemoteAddress() falls through to it we dial an address the peer may
+  // not own. getFirstRemoteAddress skips every BOGON candidate, so on an
+  // all-private-subnet deployment (e.g. a 10.0.0.0/8 test overlay) EVERY entry in
+  // addresses4 is skipped and the fallback is not an edge case — it is the only
+  // path. None of that is visible downstream unless the candidates AND their
+  // per-entry bogon verdicts are recorded, which is what this does.
+  //
+  // Non-enumerable + configurable, exactly like the WI-5863 fields below, so this
+  // cannot perturb any existing JSON.stringify/deepEqual of the stream object.
+  const es = c.encryptedSocket
+  const mark = (k, v) => {
+    if (es) Object.defineProperty(es, k, { value: v, configurable: true })
+  }
+  const candidates = Array.isArray(payload.addresses4) ? payload.addresses4 : []
+  mark('udxAddresses4', candidates.map(a => ({ host: a.host, port: a.port, bogon: isBogon(a.host) })))
+  mark('udxAddresses4AllBogon', candidates.length > 0 && candidates.every(a => isBogon(a.host)))

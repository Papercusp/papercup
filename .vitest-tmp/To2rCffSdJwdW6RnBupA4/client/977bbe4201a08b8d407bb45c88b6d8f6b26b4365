        color: var(--fg, #e7f7ff);
        border: 1px solid color-mix(in srgb, var(--accent-strong, #7dd3fc), transparent 82%);
        border-radius: 8px;
        padding: 4px 7px;
        font: inherit;
        font-size: 11.5px;
        min-width: 0;

+// @vitest-environment jsdom
+import { act, cleanup, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { usePortalSession, type PortalHostedSession } from "../packages/ui/src/auth";
+import { financeAccountForSession } from "../packages/ui/src/billing";
+
+const session: PortalHostedSession = {
+  identity: { externalUserId: "external-1", primaryEmail: "finance@example.test", emailVerified: true },
+  session: { sessionId: "session-1", userId: "user-1", organizationId: "org-1", workspaceId: null,
+    permissionVersion: 7, upstreamProvider: "workos", issuedAtMs: 1, authenticatedAtMs: 1,
+    expiresAtMs: 2, authenticationMethods: ["password"], mfaVerified: false },
+};
+const response = (status: number, value: unknown) => ({ status, json: async () => value });
+afterEach(() => { cleanup(); vi.unstubAllGlobals(); });
+
+describe("allocation finance scope", () => {
+  it("uses the billing control workspace for an organization without a customer workspace", () => {
+    expect(financeAccountForSession(session.session, { configured: true, canManage: true, subscription: null,
+      organization: { organizationId: "org-1", controlWorkspaceId: "control-1" } })).toEqual({
+      controlWorkspaceId: "control-1", organizationId: "org-1", userId: "user-1", sessionId: "session-1",
+    });
+  });
+  it("refuses missing, blank and foreign billing scope", () => {
+    for (const organization of [undefined, null, { organizationId: "org-2", controlWorkspaceId: "control-1" },
+      { organizationId: "org-1", controlWorkspaceId: " " }]) {
+      expect(financeAccountForSession(session.session, {
+        configured: true, canManage: true, subscription: null, organization,
+      })).toBeNull();
+    }
+  });
+});
+
+describe("current identity alongside frozen page routing", () => {
+  it("keeps routing stable while rejecting late checks and clearing a signed-out identity", async () => {
+    const pending: Array<{ resolve: (value: unknown) => void; signal: AbortSignal }> = [];
+    vi.stubGlobal("fetch", vi.fn((_url: string, options: RequestInit) => new Promise(resolve => {
+      pending.push({ resolve, signal: options.signal as AbortSignal });
+    })));
+    const hook = renderHook(() => usePortalSession(false));
+    await act(async () => { pending[0]!.resolve(response(200, { ok: true, ...session })); });
+    expect(hook.result.current.initial).toEqual({ kind: "first-run", value: session });
+    const recheck = () => document.dispatchEvent(new Event("visibilitychange"));
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "visible" });
+    act(() => { recheck(); recheck(); });
+    const next = { ...session, session: { ...session.session, organizationId: "org-2", permissionVersion: 8 } };
+    await act(async () => { pending[2]!.resolve(response(200, { ok: true, ...next })); });
+    await act(async () => { pending[1]!.resolve(response(200, { ok: true, ...session })); });
+    expect(hook.result.current.latest).toEqual({ kind: "first-run", value: next });
+    expect(hook.result.current.initial).toEqual({ kind: "first-run", value: session });
+    act(recheck);
+    await act(async () => { pending[3]!.resolve(response(401, {})); });
+    expect(hook.result.current.latest).toEqual({ kind: "signed-out" });
+    expect(hook.result.current.initial).toEqual({ kind: "first-run", value: session });
+    hook.unmount();
+    expect(pending[3]!.signal.aborted).toBe(true);
+  });
+  it("does not fetch hosted identities in local mode", () => {
+    const fetch = vi.fn(); vi.stubGlobal("fetch", fetch);
+    const hook = renderHook(() => usePortalSession(true));
+    expect(hook.result.current.latest).toEqual({ kind: "local" });
+    expect(fetch).not.toHaveBeenCalled();
+  });
+});

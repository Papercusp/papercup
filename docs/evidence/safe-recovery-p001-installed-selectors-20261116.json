    "collectorCommand": "python3 - <<'PY'\nimport pathlib,json,os,hashlib,datetime,socket\nfrom urllib.parse import urlsplit,urlunsplit\nunits=['papercusp-dev-api.service','papercusp-staging-api.service','papercusp-bg-host.service']\nkeys=['PAPERCUSP_HOME','PAPERCUSP_WORKSPACES_ROOT','PAPERCUSP_INTEGRATION_ROOT','PAPERCUSP_RELEASE_ROOT','PAPERCUSP_CHECKPOINT_ROOT','PAPERCUSP_STATE_DIRECTORY','STATE_DIRECTORY','PAPERCUSP_DUMP_ROOT','PAPERCUSP_PROMPT_ROOT','PROMPT_ROOT','XDG_CACHE_HOME','PAPERCUSP_PG_PORT','PAPERCUSP_PG_HOST','PAPERCUSP_HONO_PORT','PAPERCUSP_VINTAGE_UNIT','PAPERCUSP_BACKGROUND_WORKERS','PAPERCUSP_DBOS_ENABLE','PAPERCUSP_DBOS_ORCHESTRATOR','PAPERCUSP_DBOS_ROUTINES','PAPERCUSP_DBOS_TIMERS','PAPERCUSP_DBOS_AUTOLOOP','PAPERCUSP_ORCHESTRATOR_HARNESSES','PAPERCUSP_CLUSTER_ENABLE','HARNESS_DATABASE_URL','HARNESS_ADMIN_DATABASE_URL','DATABASE_URL','PAPERCUSP_PG_URL']\nrows=[]; unread=[]\nfor p in pathlib.Path('/proc').glob('[0-9]*'):\n try: cg=(p/'cgroup').read_text()\n except (FileNotFoundError,ProcessLookupError,PermissionError): continue\n unit=next((u for u in units if '/'+u in cg),None)\n if not unit:continue\n try:\n  argv=(p/'cmdline').read_bytes().replace(b'\\0',b' ').decode(errors='replace')\n  if not ('node' in argv or 'hono-host' in argv):continue\n  env=dict(x.split('=',1) for x in (p/'environ').read_bytes().decode(errors='replace').split('\\0') if '=' in x)\n  selectors={}\n  for k in keys:\n   if k not in env:continue\n   v=env[k]\n   if k.endswith('_URL'):\n    try:\n     q=urlsplit(v);v=urlunsplit((q.scheme,(q.hostname or '')+(':'+str(q.port) if q.port else ''),q.path,'',''))\n    except Exception:v='unparseable endpoint'\n   selectors[k]=v\n  providers=[]\n  for k,v in env.items():\n   if any(x in k for x in ['ENDPOINT','BASE_URL','SIDECAR_URL','GATEWAY_URL']) and not any(x in k for x in ['TOKEN','KEY','SECRET','PASSWORD']):\n    try:\n     q=urlsplit(v); safe=urlunsplit((q.scheme,(q.hostname or '')+(':'+str(q.port) if q.port else ''),q.path,'',''))\n    except Exception:safe='unparseable endpoint'\n    providers.append({'key':k,'destination':safe})\n  rows.append({'unit':unit,'pid':int(p.name),'cwd':os.readlink(p/'cwd'),'commandKind':'hono-host' if 'hono-host' in argv else 'node','selectors':selectors,'providerSelectors':providers,'configIdentity':hashlib.sha256(json.dumps(selectors,sort_keys=True).encode()).hexdigest()})\n except (FileNotFoundError,ProcessLookupError):unread.append({'unit':unit,'pid':int(p.name),'reason':'process-race'})\n except PermissionError:unread.append({'unit':unit,'pid':int(p.name),'reason':'permission'})\nresult={'observedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'startup environment and loaded cwd of exact configured operator/background units; runtime-mutated env and transient external sockets not proven','units':units,'processes':rows,'unread':unread,'unobservedUnits':[u for u in units if not any(r['unit']==u for r in rows)]}\npathlib.Path('/tmp/e48-p001-installed-selectors.json').write_text(json.dumps(result,indent=2))\nprint(json.dumps(result))\nPY"

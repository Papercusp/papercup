flowchart TB
  Clients["Staff UI / browser extension / API clients"]
  Edge["Cloudflare tunnel → nginx<br/>Historical/configured ingress; live routing not verified"]
  Clients --> Edge
  subgraph Host["Configured same-host Owner-project deployment"]
    Parent["Parent Express API :8000<br/>Router + Auth + ServiceManager"]
    Core["Domain processes<br/>Inventory / Leads / Parser / Matcher / Transformer"]
    Sync["Synchronizer<br/>stock, cost, price and quantity calculations"]
    Market["MarketplaceStuff + adapters<br/>Amazoner / Amazon / eBay / others"]
    Orders["DataFetcher + OrderProcessor<br/>order aggregation and fulfillment options"]
    Jobs["Runners + Scheduler<br/>workflow orchestration and in-process schedules"]
    Workers["Worker threads<br/>CPU-heavy calculations"]
    Data["DataStore<br/>shared datasets and local helpers"]
    Mongo[("Shared MongoDB<br/>admin database; overlapping collections")]
    LMDB[("LMDB-backed SharedMap<br/>datasets, RPC results and cache")]
    SQLite[("Per-service SQLite<br/>plus JSON/JSONL files")]
    Castle["Wolfcastle :4000<br/>external companion application"]
    Parent -->|"HTTP RPC; static port offsets"| Core
    Parent -->|"HTTP RPC"| Sync
    Parent -->|"HTTP RPC"| Market
    Parent -->|"HTTP RPC"| Orders
    Parent -->|"HTTP RPC"| Jobs
    Core & Sync & Market & Orders & Jobs -->|"RPC returns through parent"| Parent
    Core & Sync & Market & Orders -->|"in-process helpers where co-loaded"| Data
    Parent & Core & Sync & Market & Orders --> Mongo
    Parent & Core & Sync & Market & Orders & Data --> LMDB
    Sync & Market --> Workers
    Sync & Orders & Core --> SQLite
    Parent -->|"Sheets / Datasheets → localhost/castle"| Castle
  end
  Edge --> Parent
  Suppliers["Supplier sources<br/>Dell / Hubx / generic feeds"]
  Platforms["Marketplace APIs<br/>Amazon / eBay / Back Market / Walmart / Newegg / Mirakl / Reebelo"]
  Fulfillment["Easyship / shipping services"]
  Sheets["Google Sheets<br/>operational workflow data"]
  SQS["Amazon SQS / SNS integrations<br/>notifications and advertising data"]
  Core --> Suppliers
  Market --> Platforms
  Orders --> Fulfillment
  Castle --> Sheets
  SQS --> Market

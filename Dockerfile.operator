# Dockerfile.operator — apps/operator (harness backend, internal-only)
#
# Same monorepo install pattern as Dockerfile.papercup. Operator is the
# harness backend; papercup proxies /api/harness/*, /api/plugins/* to it.
# Not exposed via Traefik — papercup container reaches it at http://operator:3055
# on the internal docker network.
#
# node-pty native bindings: next.config.js force-includes them in the
# standalone tracer. Alpine ships with build-base if we need to rebuild,
# but the @lydell/node-pty-linux-x64 prebuild matches alpine x64 directly.

FROM node:20-bookworm-slim AS builder

# build-essential for native bindings (@lydell/node-pty needs to compile
# against glibc, not musl).
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/papercup/package.json    ./apps/papercup/
COPY apps/operator/package.json    ./apps/operator/
COPY packages/plugin-loader/package.json ./packages/plugin-loader/
COPY packages/plugin-sdk/package.json    ./packages/plugin-sdk/
COPY libs/agent-chat/package.json        ./libs/agent-chat/
COPY libs/generic/git-graph/package.json         ./libs/generic/git-graph/
COPY libs/papercusp-db/package.json       ./libs/papercusp-db/
COPY libs/papercusp-shared/package.json   ./libs/papercusp-shared/
COPY libs/generic/ui-primitives/package.json     ./libs/generic/ui-primitives/
COPY libs/zero-harness/package.json      ./libs/zero-harness/
COPY libs/marketplace-public-ui/package.json ./libs/marketplace-public-ui/
COPY libs/papercusp-export-state/package.json ./libs/papercusp-export-state/
COPY libs/papercusp-publish-auth/package.json ./libs/papercusp-publish-auth/
COPY libs/generic/sync/package.json ./libs/generic/sync/
COPY libs/generic/papergrid/grid-core/package.json ./libs/generic/papergrid/grid-core/
COPY libs/generic/papergrid/grid/package.json      ./libs/generic/papergrid/grid/
COPY libs/papercusp/libs/db/package.json              ./libs/papercusp/libs/db/
COPY libs/papercusp/packages/harness/package.json     ./libs/papercusp/packages/harness/
COPY libs/papercusp/packages/orchestrator/package.json ./libs/papercusp/packages/orchestrator/

RUN npm install --legacy-peer-deps

COPY apps/operator/ ./apps/operator/
COPY libs/         ./libs/
COPY packages/     ./packages/

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /repo/apps/operator
RUN npm run build

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS runner
WORKDIR /repo

# Runtime tools the harness shells out to. Debian here so node-pty's glibc
# native binding loads without a re-compile dance.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git openssh-client bash curl jq ripgrep ca-certificates gnupg python3 postgresql-client \
 && (curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | tee /usr/share/keyrings/githubcli-archive-keyring.gpg > /dev/null \
     && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
     && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
     && apt-get update && apt-get install -y --no-install-recommends gh) \
 && rm -rf /var/lib/apt/lists/*

# Agent CLIs + tsx (for the papercusp CLI wrapper) installed globally.
# Default backend is omp (routes through Meridian + Claude Max OAuth);
# claude is also installed as a fallback for users who set
# AGENT_BACKEND=claude-code. Meridian itself runs as a separate sidecar
# container — operator talks HTTP to it on MERIDIAN_BASE_URL (default
# http://meridian:3456 in compose).
RUN npm install -g \
      @anthropic-ai/claude-code \
      @oh-my-pi/cli \
      @rynfar/meridian \
      tsx

COPY --from=builder /repo/apps/operator/.next/standalone ./
COPY --from=builder /repo/apps/operator/.next/static ./apps/operator/.next/static
RUN mkdir -p apps/operator/public
COPY --from=builder /repo/apps/operator/public ./apps/operator/public

# node-pty's native binding ships as a prebuild in
# @lydell/node-pty-linux-x64/prebuilds. Next's tracer doesn't pick up .node
# files; copy the prebuild into the standalone tree so the runtime resolver
# finds it.
COPY --from=builder /repo/node_modules/@lydell/node-pty-linux-x64/prebuilds \
     ./node_modules/@lydell/node-pty-linux-x64/prebuilds

# Harness package — run.sh, prompts, templates. PAPERCUSP_HARNESS_DIR
# (set in compose) points operator's harness-paths.ts at this location.
COPY --from=builder /repo/libs/papercusp/packages/harness /opt/harness

# papercusp CLI — symlinked into PATH. The wrapper script finds tsx
# globally (installed above) so it doesn't need a local node_modules.
COPY --from=builder /repo/libs/papercusp /opt/papercusp
RUN ln -sf /opt/papercusp/packages/cli/bin/papercusp /usr/local/bin/papercusp \
 && chmod +x /opt/papercusp/packages/cli/bin/papercusp

ENV PORT=3055
ENV HOSTNAME=0.0.0.0
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PAPERCUSP_HARNESS_DIR=/opt/harness
# meridian default: in-container loopback. compose overrides if running
# meridian as a sibling service.
ENV MERIDIAN_BASE_URL=http://127.0.0.1:3456
EXPOSE 3055

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
  CMD wget -q --spider http://127.0.0.1:3055/ || exit 1

# Start meridian in the background, then the operator. Meridian needs
# ~/.claude credentials (mounted by compose) — it speaks the Anthropic
# API on :3456 and routes omp invocations through Claude Max OAuth.
# Operator + meridian run in the same container so failures are colocated;
# meridian fails non-fatally (operator stays up; preflight surfaces the
# 'meridian missing' state and the user is prompted to investigate).
CMD ["bash", "-c", "(meridian > /var/log/meridian.log 2>&1 &) && exec node apps/operator/server.js"]

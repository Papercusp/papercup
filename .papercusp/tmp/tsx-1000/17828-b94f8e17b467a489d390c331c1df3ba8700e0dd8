ntSchema.parse({id:\"x\",workItem:{kind:\"feature\"},spine:{edges:{DONE:{to:\"done\"}}},triggers:{schedule}}),\"withSchedule\");test(\"tier defaults to durable; a durable cron schedule has no trigger errors\",()=>{const bp=withSchedule([{cron:\"*/5 * * * *\"}]);assert.equal(bp.triggers.schedule[0].tier,\"durable\");const v=validateBlueprint(bp);const trigErrs=v.errors.filter(e=>e.code.startsWith(\"ephemeral-\")||e.code===\"durable-no-cron\");assert.equal(trigErrs.length,0,JSON.stringify(trigErrs))});test(\"tier:ephemeral with a deterministic action + intervalSec validates (no trigger errors)\",()=>{const bp=withSchedule([{tier:\"ephemeral\",action:\"system:hive-watchdog-sweep\",intervalSec:5}]);const v=validateBlueprint(bp);assert.equal(v.errors.filter(e=>e.code.startsWith(\"ephemeral-\")).length,0,JSON.stringify(v.errors))});test(\"tier:ephemeral that omits action (defaults to system:blueprint-run) AND intervalSec \\u2192 two contract errors\",()=>{const bp=withSchedule([{tier:\"ephemeral\"}]);const v=validateBlueprint(bp);assert.equal(v.ok,false);assert.ok(v.errors.some(e=>e.code===\"ephemeral-blueprint-run-action\"),JSON.stringify(v.errors));assert.ok(v.errors.some(e=>e.code===\"ephemeral-no-interval\"),JSON.stringify(v.errors))});test(\"tier:ephemeral intervalSec below the floor \\u2192 ephemeral-interval-floor (raw/out-of-band path)\",()=>{const bp=withSchedule([{tier:\"ephemeral\",action:\"system:foo\",intervalSec:5}]);bp.triggers.schedule[0].intervalSec=0;const v=validateBlueprint(bp);assert.ok(v.errors.some(e=>e.code===\"ephemeral-interval-floor\"),JSON.stringify(v.errors))});test(\"tier:ephemeral coarse intervalSec (\\u226560s) + a stray cron \\u2192 warnings, not errors\",()=>{const bp=withSchedule([{tier:\"ephemeral\",action:\"system:foo\",intervalSec:120,cron:\"* * * * *\"}]);const v=validateBlueprint(bp);assert.equal(v.errors.filter(e=>e.code.startsWith(\"ephemeral-\")).length,0,JSON.stringify(v.errors));assert.ok(v.warnings.some(w=>w.code===\"ephemeral
{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import{test}from\"vitest\";import assert from\"node:assert/strict\";import{readFileSync}from\"node:fs\";import{parse as parseYaml}from\"yaml\";import{harnessPath}from\"@papercusp/harness/paths\";import{BlueprintSchema}from\"./schema.js\";import{validateBlueprint}from\"./validate.js\";const coding=BlueprintSchema.parse(parseYaml(readFileSync(harnessPath(\"blueprints\",\"coding-factory\",\"blueprint.yaml\"),\"utf8\")));test(\"coding blueprint validates with no errors\",()=>{const v=validateBlueprint(coding);assert.equal(v.ok,true,`unexpected errors: ${JSON.stringify(v.errors)}`);assert.equal(v.errors.length,0)});test(\"coding blueprint warns ONLY about the vestigial undeclared dispatch roles\",()=>{const v=validateBlueprint(coding);const undeclared=v.warnings.filter(w=>w.code===\"dispatch-undeclared-role\").map(w=>w.message);assert.equal(undeclared.length,3,`got: ${JSON.stringify(undeclared)}`);for(const role of[\"tester\",\"test-writer\",\"monitor\"]){assert.ok(undeclared.some(m=>m.includes(`\"${role}\"`)),`expected an undeclared-role warning for ${role}`)}assert.equal(v.warnings.filter(w=>w.code===\"unused-role\").length,0);assert.equal(v.warnings.filter(w=>w.code===\"decider-undeclared\").length,0)});test(\"empty spine \\u2192 error\",()=>{const bp=BlueprintSchema.parse({id:\"x\",workItem:{kind:\"feature\"},spine:{edges:{},default:{to:\"idle\"}}});const v=validateBlueprint(bp);assert.equal(v.ok,false);assert.ok(v.errors.some(e=>e.code===\"empty-spine\"))});test(\"self-claim spine (no edges/steps) is VALID \\u2014 flat-distributed topology has no central decider\",()=>{const bp=BlueprintSchema.parse({id:\"dist-broadcast\",workItem:{kind:\"feature\"},spine:{claimModel:\"self-claim-fifo\"},roles:[{id:\"worker\"}],coordination:{broadcast:\"topic\"}});const v=validateBlueprint(bp);assert.ok(!v.errors.some(e=>e.code===\"empty-spine\"),`self-claim m
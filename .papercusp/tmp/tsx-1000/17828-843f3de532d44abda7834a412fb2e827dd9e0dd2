{"code":"import{RulesEngine}from\"./engine\";import{evaluateCondition,evaluateDataCondition}from\"./matcher\";import{evaluateOperatorTest,isOperatorTest,isPlainObject,OPERATOR_KEYS}from\"./operators\";import{compileToMingo,compileLeafClauses}from\"./compile\";import{getPath,hasPath,splitPath}from\"./path\";import{deepEqual}from\"./deep-equal\";import{validateRuleShape,RuleValidationError}from\"./validate\";import{serializableRuleSchema,dataConditionSchema,operatorTestSchema,parseSerializableRule,safeParseSerializableRule,parseSerializableRules,KNOWN_OPERATORS}from\"./schema\";export{KNOWN_OPERATORS,OPERATOR_KEYS,RuleValidationError,RulesEngine,compileLeafClauses,compileToMingo,dataConditionSchema,deepEqual,evaluateCondition,evaluateDataCondition,evaluateOperatorTest,getPath,hasPath,isOperatorTest,isPlainObject,operatorTestSchema,parseSerializableRule,parseSerializableRules,safeParseSerializableRule,serializableRuleSchema,splitPath,validateRuleShape};\n","warnings":[],"map":{"version":3,"mappings":"AAeA,OAAS,gBAAmB,WAC5B,OAAS,kBAAmB,0BAA6B,YACzD,OAAS,qBAAsB,eAAgB,cAAe,kBAAqB,cAEnF,OAAS,eAAgB,uBAA0B,YAEnD,OAAS,QAAS,QAAS,cAAiB,SAC5C,OAAS,cAAiB,eAC1B,OAAS,kBAAmB,wBAA2B,aACvD,OACE,uBACA,oBACA,mBACA,sBACA,0BACA,uBACA,oBACK","names":[],"ignoreList":[],"sources":["/home/marsh-office/papercupai-workspace/papercusp/libs/generic/rules/src/index.ts"],"sourcesContent":["/**\n * @papercusp/rules — a generic, pure ECA (Event-Condition-Action) rules engine.\n *\n * Register rules `{ id, on, when, fire, args }`; given an event, `match()`\n * returns the actions that should fire. Indexed by trigger key for O(matching);\n * `when` is a declarative data-matcher (a curated MatchMap vocabulary evaluated\n * by a mingo-backed leaf compiler — see compile.ts) plus a JS-predicate\n * escape-hatch; rules are Zod-validatable in their serializable form.\n *\n * PURE: no I/O, no dispatch, no durability, no loop-protection — those are the\n * consumer's concern (rules-engine D-002). The lib decides WHAT should fire; the\n * consumer FIRES it. The first consumer is the event-reaction-system, but the\n * lib is consumer-agnostic (generic over the event + fire types).\n */\n\nexport { RulesEngine } from './engine';\nexport { evaluateCondition, evaluateDataCondition } from './matcher';\nexport { evaluateOperatorTest, isOperatorTest, isPlainObject, OPERATOR_KEYS } from './operators';\nexport type { OperatorKey, OperatorTest } from './operators';\nexport { compileToMingo, compileLeafClauses } from './compile';\nexport type { MingoQuery } from './compile';\nexport { getPath, hasPath, splitPath } from './path';\nexport { deepEqual } from './deep-equal';\nexport { validateRuleShape, RuleValidationError } from './validate';\nexport {\n  serializableRuleSchema,\n  dataConditionSchema,\n  operatorTestSchema,\n  parseSerializableRule,\n  safeParseSerializableRule,\n  parseSerializableRules,\n  KNOWN_OPERATORS,\n} from './schema';\nexport type { SerializableRule } from './schema';\nexport type {\n  TriggerKey,\n  MatchMap,\n  DataCondition,\n  Predicate,\n  Condition,\n  ArgsTemplate,\n  Rule,\n  MatchedAction,\n  RulesEngineOptions,\n} from './types';\n"]}}
#!/usr/bin/env bash
# Wrapper that runs the TypeScript fire-hook CLI via tsx.
#
# Node 25's --experimental-strip-types doesn't add file extensions to
# bare relative imports, so we always need a real TS loader. Resolution
# order: PATH (`tsx`), repo-local (`node_modules/.bin/tsx`), npx fallback.
set -euo pipefail
SELF="$(readlink -f "$0")"
HERE="$(cd "$(dirname "$SELF")" && pwd)"
SCRIPT="$HERE/fire-hook.ts"

# Walk up looking for a node_modules/.bin/tsx (works from any subpackage).
DIR="$HERE"
LOCAL_TSX=""
while [ "$DIR" != "/" ]; do
  if [ -x "$DIR/node_modules/.bin/tsx" ]; then
    LOCAL_TSX="$DIR/node_modules/.bin/tsx"
    break
  fi
  DIR="$(dirname "$DIR")"
done

if command -v tsx >/dev/null 2>&1; then
  exec tsx "$SCRIPT" "$@"
elif [ -n "$LOCAL_TSX" ]; then
  exec "$LOCAL_TSX" "$SCRIPT" "$@"
else
  exec npx --yes tsx "$SCRIPT" "$@"
fi

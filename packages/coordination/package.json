{
  "name": "@papercusp/coordination",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent coordination substrate, extracted as host-agnostic seams: coord-core (pure envelope types + identity-free fold/merge/glob protocol logic), CoordEventLog (the swappable append-only channel-log seam — fs default + in-memory double + workspace-scoped single-table Postgres backend; covers messages/handoffs/escalations/plan-events), PresenceStore (live presence), WatermarkStore (per-agent read cursors), and SubscriptionStore (path/glob watches) — each over an injected PgHandle with an in-memory double, all passing one conformance suite. No @papercusp/@restart runtime deps; identity resolution stays host-side by design.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./event-log": {
      "types": "./src/event-log/index.ts",
      "import": "./src/event-log/index.ts",
      "default": "./src/event-log/index.ts"
    },
    "./event-log/conformance": {
      "types": "./src/event-log/conformance.ts",
      "import": "./src/event-log/conformance.ts",
      "default": "./src/event-log/conformance.ts"
    },
    "./presence": {
      "types": "./src/presence/index.ts",
      "import": "./src/presence/index.ts",
      "default": "./src/presence/index.ts"
    },
    "./presence/conformance": {
      "types": "./src/presence/conformance.ts",
      "import": "./src/presence/conformance.ts",
      "default": "./src/presence/conformance.ts"
    },
    "./watermark-store": {
      "types": "./src/watermark-store/index.ts",
      "import": "./src/watermark-store/index.ts",
      "default": "./src/watermark-store/index.ts"
    },
    "./watermark-store/conformance": {
      "types": "./src/watermark-store/conformance.ts",
      "import": "./src/watermark-store/conformance.ts",
      "default": "./src/watermark-store/conformance.ts"
    },
    "./subscription-store": {
      "types": "./src/subscription-store/index.ts",
      "import": "./src/subscription-store/index.ts",
      "default": "./src/subscription-store/index.ts"
    },
    "./subscription-store/conformance": {
      "types": "./src/subscription-store/conformance.ts",
      "import": "./src/subscription-store/conformance.ts",
      "default": "./src/subscription-store/conformance.ts"
    },
    "./capabilities": {
      "types": "./src/capabilities/index.ts",
      "import": "./src/capabilities/index.ts",
      "default": "./src/capabilities/index.ts"
    },
    "./capabilities/conformance": {
      "types": "./src/capabilities/conformance.ts",
      "import": "./src/capabilities/conformance.ts",
      "default": "./src/capabilities/conformance.ts"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "vitest": "^4.1.4"
  }
}

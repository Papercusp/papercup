{
  "name": "@papercusp/operator-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless operator backend — agent-tools, endpoint-route handlers, harness logic, host composition. Zero UI/React dependency; consumed by apps/operator (the UI package) and the desktop sidecar. Carved from apps/operator in SP1 C4 (plan operator-core-headless-serve-2026-06-04). Resolution is via the consumer's tsconfig path / vite alias (source-only, no build); internal imports are relative.",
  "main": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./lib/*": "./lib/*.ts",
    "./lib/*.ts": "./lib/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "lint:chunk-safe": "vitest run lib/child-output-guard.test.ts",
    "lint:attributor-runner-coverage": "vitest run lib/__tests__/attributor-runner-coverage.test.ts",
    "lint:guard-reachability": "node ../../scripts/check-lint-guard-reachability.mjs",
    "lint:sidecar-fallback-reported": "node ../../scripts/check-sidecar-fallback-reported.mjs",
    "lint:no-unhosted-remote-core": "node ../../scripts/check-no-unhosted-remote-core.mjs",
    "lint:partial-index-alignment": "node ../../scripts/check-partial-index-alignment.mjs",
    "lint:no-undrained-stdout-exit": "node ../../scripts/check-undrained-stdout-exit.mjs",
    "lint:migration-forward-compat": "node ../../scripts/check-migration-forward-compat.mjs",
    "lint:no-unthreaded-apply": "node ../../scripts/check-no-unthreaded-apply.mjs",
    "lint:okf-conformance": "tsx ../../scripts/check-okf-conformance.mjs",
    "lint:drop-database-force": "node ../../scripts/check-drop-database-force.mjs",
    "lint:js-syntax": "node ../../scripts/check-js-syntax.mjs",
    "lint:no-retired": "node ../../scripts/check-no-retired-imports.mjs",
    "lint:no-raw-spawn": "node ../../scripts/check-no-raw-agent-spawn.mjs",
    "lint:no-retired-resurrection": "node ../../scripts/check-retired-resurrection.mjs",
    "lint:vimock-export-strands": "node ../../scripts/check-vimock-export-strands.mjs",
    "lint:workspace-deps-complete": "node ../../scripts/check-workspace-deps-complete.mjs",
    "lint:no-ungated-mug-kettle": "node ../../scripts/check-ungated-mug-kettle.mjs",
    "lint:vacuous-flag-guard": "node ../../scripts/check-vacuous-flag-guard.mjs",
    "lint:no-unreachable-tier-mock": "node ../../scripts/check-unreachable-tier-mock.mjs",
    "lint:green-checkpoint-tag": "node ../../scripts/check-green-checkpoint-tag.mjs",
    "gen:authored-docs:check": "tsx ../../scripts/project-authored-docs.ts --check",
    "gen:compaction:check": "tsx ../../scripts/gen-compaction.ts --check",
    "gen:knowledge-packs:check": "node ../../scripts/gen-knowledge-packs.mjs --check",
    "lint:declarations-fresh": "tsx ../../scripts/gen-declarations.ts --check",
    "typecheck": "bash ../../scripts/pc-heavy.sh node ../../scripts/lint-tsc.mjs"
  },

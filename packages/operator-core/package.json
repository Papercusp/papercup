{
  "name": "@papercusp/operator-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless operator backend — agent-tools, endpoint-route handlers, harness logic, host composition. Zero UI/React dependency; consumed by apps/operator (the UI package) and the desktop sidecar. Carved from apps/operator in SP1 C4 (plan operator-core-headless-serve-2026-06-04). Resolution is via the consumer's tsconfig path / vite alias (source-only, no build); internal imports are relative.",
  "main": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./lib/*": "./lib/*.ts",
    "./lib/*.ts": "./lib/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "lint:chunk-safe": "vitest run lib/child-output-guard.test.ts",
    "lint:partial-index-alignment": "node ../../scripts/check-partial-index-alignment.mjs",
    "lint:migration-forward-compat": "node ../../scripts/check-migration-forward-compat.mjs",
    "lint:no-unthreaded-apply": "node ../../scripts/check-no-unthreaded-apply.mjs",
    "lint:okf-conformance": "tsx ../../scripts/check-okf-conformance.mjs",
    "typecheck": "node ../../scripts/lint-tsc.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@iarna/toml": "^2.2.5",
    "@papercusp/activity-bridge": "*",
    "@papercusp/audio-dsp": "*",
    "@papercusp/bench-metrics": "*",
    "@papercusp/blueprint-distribution": "*",
    "@papercusp/cache": "*",
    "@papercusp/chat-protocol": "*",
    "@papercusp/control-mutation": "*",
    "@papercusp/debounce-coalesce": "*",
    "@papercusp/deployment-driver": "*",
    "@papercusp/docs-engine": "*",
    "@papercusp/eval-battery": "*",
    "@papercusp/event-reaction": "*",
    "@papercusp/failure-detector": "*",
    "@papercusp/flags": "*",
    "@papercusp/image-blankness": "*",
    "@papercusp/kokoro-tts": "*",
    "@papercusp/locks-core": "*",
    "@papercusp/memory": "*",
    "@papercusp/model-pricing": "*",
    "@papercusp/module-singleton": "*",
    "@papercusp/orchestrator": "*",
    "@papercusp/p2p-voice": "*",
    "@papercusp/plan-parser": "*",
    "@papercusp/rerank": "*",
    "@papercusp/resource-profile": "*",
    "@papercusp/result-encoding": "*",
    "@papercusp/rrf": "*",
    "@papercusp/rules": "*",
    "@papercusp/scheduled-registry": "*",
    "@papercusp/search-core": "*",
    "@papercusp/seed-bundle": "*",
    "@papercusp/step-program": "*",
    "@papercusp/structured-concurrency": "*",
    "esbuild": "^0.27.3",
    "fractional-indexing": "^3.2.0",
    "phonemizer": "^1.2.1",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "js-tiktoken": "*",
    "vitest": "^4.1.4"
  }
}

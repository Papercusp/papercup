#!/usr/bin/env bash
# pre-push — enforce "main is automation-only" (staging-branch-pipeline-2026-06-06).
#
# The superproject's `main` is the GREEN branch: it only ever fast-forwards to a
# `staging` commit that passed the green-checkpoint suite, and ONLY the
# green-checkpoint automation may push it (it sets PAPERCUSP_MAIN_PUSH_OK=1).
# Everyone else — agents, humans, git-sync — pushes `staging`.
#
# GitHub-side branch protection is unavailable on this repo (private repo,
# free plan → 403), so this LOCAL hook is the enforcement point — which is
# sufficient here because every pusher (agents, git-sync, green-checkpoint)
# runs on this box and all worktrees share the common .git hooks dir.
#
# Install (idempotent; done by the cutover, re-run if .git is ever recreated):
#   cp bin/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# stdin: one line per ref being pushed: "<local ref> <local sha> <remote ref> <remote sha>"
[ "${PAPERCUSP_MAIN_PUSH_OK:-}" = "1" ] && exit 0
while read -r _local _lsha remote _rsha; do
  if [ "$remote" = "refs/heads/main" ]; then
    echo "✖ push to main BLOCKED: main is automation-only — green-checkpoint fast-forwards it from green staging." >&2
    echo "  Your work lands on staging (git-sync owns commit+push); main advances when the suite is green." >&2
    echo "  See CLAUDE.md §Branch discipline + apps/operator/lib/release/README.md." >&2
    exit 1
  fi
done
exit 0
